/* Reliable world-channel metadata follows static terrain and precedes WORLD_END. */
static void cm_net_send(int peer){if(!useCustomMap||!cmRuntime)return;uint8_t packet[FPS_NET_MAX_PACKET];NetWriter w;
 net_writer_init(&w,packet,sizeof(packet));net_write_header(&w,NET_MSG_MAP_METADATA,0,netTransport.session_id,netServerTick);net_write_u8(&w,0);for(int n=0;n<CM_NAME;n++)net_write_u8(&w,cmRuntime->name[n]);net_write_u8(&w,cmRuntime->duckCount);for(int n=0;n<cmRuntime->duckCount;n++){net_write_f32(&w,cmRuntime->ducks[n].x);net_write_f32(&w,cmRuntime->ducks[n].y);net_write_f32(&w,cmRuntime->ducks[n].z);}net_transport_send(&netTransport,peer,FPS_NET_CHANNEL_WORLD,packet,w.length,true);
 for(int n=0;n<cmRuntime->spawnCount;n++){CmSpawn *s=&cmRuntime->spawns[n];net_writer_init(&w,packet,sizeof(packet));net_write_header(&w,NET_MSG_MAP_METADATA,0,netTransport.session_id,netServerTick);net_write_u8(&w,1);net_write_u8(&w,s->kind);net_write_u8(&w,s->group);net_write_f32(&w,s->pos.x);net_write_f32(&w,s->pos.y);net_write_f32(&w,s->pos.z);net_write_f32(&w,s->yaw);net_transport_send(&netTransport,peer,FPS_NET_CHANNEL_WORLD,packet,w.length,true);}
 for(int t=0;t<foundryTrapCount;t++){FoundryTrap *f=&foundryTraps[t];for(int begin=0;begin<f->originalCount;begin+=48){net_writer_init(&w,packet,sizeof(packet));net_write_header(&w,NET_MSG_MAP_METADATA,0,netTransport.session_id,netServerTick);net_write_u8(&w,2);net_write_u8(&w,t);int count=fminf(48,f->originalCount-begin);net_write_u8(&w,count);for(int k=begin;k<begin+count;k++){Voxel *v=&f->original[k];net_write_i32(&w,v->gx);net_write_i32(&w,v->gy);net_write_i32(&w,v->gz);net_write_u8(&w,f->cellFlags[k]);net_write_u8(&w,v->color.r);net_write_u8(&w,v->color.g);net_write_u8(&w,v->color.b);net_write_u8(&w,v->color.a);net_write_u8(&w,v->reinforced);}net_transport_send(&netTransport,peer,FPS_NET_CHANNEL_WORLD,packet,w.length,true);}}
}
static void cm_net_receive(NetReader *r){int kind=net_read_u8(r);if(kind==0){CmMap *m=cm_new();if(!m)return;m->width=FLOOR_SIZE*2;m->periodic=worldPeriodic;for(int n=0;n<CM_NAME;n++)m->name[n]=net_read_u8(r);m->name[CM_NAME-1]=0;m->duckCount=net_read_u8(r);if(m->duckCount>MAP_DUCKS){cm_free(m);return;}for(int n=0;n<m->duckCount;n++){m->ducks[n]=(Vector3){net_read_f32(r),net_read_f32(r),net_read_f32(r)};if(!cm_inside(m,m->ducks[n]))r->failed=true;}if(r->failed){cm_free(m);return;}cm_free(cmRuntime);cmRuntime=m;}
 else if(kind==1&&cmRuntime){CmSpawn s={0};s.kind=net_read_u8(r);s.group=net_read_u8(r);s.pos=(Vector3){net_read_f32(r),net_read_f32(r),net_read_f32(r)};s.yaw=net_read_f32(r);if(!r->failed&&s.kind<=CM_BOSS&&s.group<32&&isfinite(s.yaw)&&cm_inside(cmRuntime,s.pos)&&cmRuntime->spawnCount<CM_SPAWNS)cmRuntime->spawns[cmRuntime->spawnCount++]=s;}
 else if(kind==2&&cmRuntime){int index=net_read_u8(r),count=net_read_u8(r);if(index>=FOUNDRY_TRAPS||count>48)return;FoundryTrap *t=&foundryTraps[index];if(t->originalCount+count>FOUNDRY_TRAP_PAYLOAD)return;Voxel cells[48]={0};unsigned char flags[48];for(int n=0;n<count;n++){Voxel *v=&cells[n];v->gx=net_read_i32(r);v->gy=net_read_i32(r);v->gz=net_read_i32(r);flags[n]=net_read_u8(r);v->color=(Color){net_read_u8(r),net_read_u8(r),net_read_u8(r),net_read_u8(r)};v->reinforced=net_read_u8(r);if(flags[n]>7||v->gx< -512||v->gx>512||v->gy<0||v->gy>512||v->gz< -512||v->gz>512)r->failed=true;v->owner=-1;}if(r->failed)return;
 if(!t->original){*t=(FoundryTrap){.kind=FOUNDRY_BAY,.explicitCells=true,.owner=-1,.x0=INT_MAX,.y0=INT_MAX,.z0=INT_MAX,.x1=INT_MIN,.y1=INT_MIN,.z1=INT_MIN};t->original=calloc(FOUNDRY_TRAP_PAYLOAD,sizeof(Voxel));if(!t->original)return;}foundryTrapCount=fmaxf(foundryTrapCount,index+1);cmRuntime->trapCount=foundryTrapCount;
 for(int n=0;n<count;n++){Voxel *v=&cells[n];int k=t->originalCount++;t->original[k]=*v;t->cellFlags[k]=flags[n];t->x0=fminf(t->x0,v->gx);t->x1=fmaxf(t->x1,v->gx);t->y0=fminf(t->y0,v->gy);t->y1=fmaxf(t->y1,v->gy);t->z0=fminf(t->z0,v->gz);t->z1=fmaxf(t->z1,v->gz);}}
}
