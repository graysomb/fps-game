static struct {
    UnitVoxelBuffer buffer;
    int ticks,activation_step,original_particles;
    float max_dependency,max_penetration,max_strain,final_strain;
    int histogram[32];
    FILE *positions;
    bool fine,fracture,fracture_injected,fracture_pointer_split;
    uint64_t fracture_identity;
    double physics_seconds;
    int physics_steps;
    int pending_steps;
} greedyDebug;

static bool debug_setup_greedy_fracture(DebugRunState *state){debug_reset_world();memset(&greedyDebug,0,sizeof(greedyDebug));memset(&greedyStageProfile,0,sizeof(greedyStageProfile));greedyStageProfile.enabled=true;greedyFixture=true;greedyFineFixture=false;greedyFractureFixture=true;greedyActivationCubes=true;greedyDebug.fracture=true;activePlayers=0;greedyDebug.activation_step=20;
    for(int z=-2;z<2;z++)for(int y=10;y<14;y++)for(int x=-6;x<6;x++){int v=debug_add_cell(x,y,z,true,false,(Color){115,125,138,255},DEBUG_TEST_TAG);if(v<0)return false;Voxel *voxel=&voxels[v];voxel->pendingActivation=true;if(!unit_voxel_buffer_push(&greedyDebug.buffer,x,y,z,voxel->color,voxel->type,voxel->fixed,v,voxel->debugClusterTag,-1))return false;}
    greedyDebug.original_particles=greedyDebug.buffer.count*8;greedyFixtureCellCount=greedyDebug.buffer.count;state->expected_voxels=greedyDebug.buffer.count;state->activation_succeeded=true;char path[DEBUG_PATH_CAPACITY];if(!debug_join_path(path,sizeof(path),state->output_dir,"greedy-positions.csv"))return false;greedyDebug.positions=fopen(path,"w");if(!greedyDebug.positions)return false;fputs("step,particle,x,y,z,vx,vy,vz\n",greedyDebug.positions);debug_set_initial_centroid(state);state->camera.position=(Vector3){10,10,17};state->camera.target=(Vector3){0,5.5f,0};return true;}

static bool debug_setup_greedy_irregular(DebugRunState *state){
    debug_reset_world();memset(&greedyDebug,0,sizeof(greedyDebug));memset(&greedyStageProfile,0,sizeof(greedyStageProfile));greedyStageProfile.enabled=true;greedyFixture=true;greedyFractureFixture=false;greedyDebug.fine=strstr(debugRunConfig.scenario,"-fine")!=NULL;greedyFineFixture=greedyDebug.fine;greedyActivationCubes=!greedyDebug.fine;activePlayers=0;greedyDebug.activation_step=20;
    for(int z=-6;z<6;z++)for(int y=8;y<20;y++)for(int x=-6;x<6;x++){
        if(x>=-2&&x<2&&y>=12&&y<16)continue;if(debug_add_cell(x,y,z,true,false,(Color){115,125,138,255},DEBUG_TEST_TAG)<0)return false;}
    for(int z=-2;z<=2;z++)for(int y=8;y<13;y++)for(int x=6;x<11;x++)if(debug_add_cell(x,y,z,true,false,(Color){115,125,138,255},DEBUG_TEST_TAG)<0)return false;
    for(int z=-1;z<=1;z++)for(int y=8;y<11;y++)for(int x=11;x<14;x++)if(debug_add_cell(x,y,z,true,false,(Color){115,125,138,255},DEBUG_TEST_TAG)<0)return false;
    for(int x=14;x<18;x++)if(debug_add_cell(x,8,0,true,false,(Color){115,125,138,255},DEBUG_TEST_TAG)<0)return false;
    for(int i=0;i<voxel_count;i++){Voxel *v=&voxels[i];v->pendingActivation=true;if(!unit_voxel_buffer_push(&greedyDebug.buffer,v->gx,v->gy,v->gz,v->color,v->type,v->fixed,i,v->debugClusterTag,-1))return false;}
    greedyDebug.original_particles=greedyDebug.buffer.count*8;greedyFixtureCellCount=greedyDebug.buffer.count;state->expected_voxels=greedyDebug.buffer.count;state->activation_succeeded=true;
    char path[DEBUG_PATH_CAPACITY];if(!debug_join_path(path,sizeof(path),state->output_dir,"greedy-positions.csv"))return false;greedyDebug.positions=fopen(path,"w");if(!greedyDebug.positions)return false;
    fputs("step,particle,x,y,z,vx,vy,vz\n",greedyDebug.positions);debug_set_initial_centroid(state);state->camera.position=(Vector3){13,10,17};state->camera.target=(Vector3){2,6,0};return true;
}
static void debug_greedy_step(DebugRunState *state){(void)state;greedyDebug.ticks++;if(greedyDebug.ticks==greedyDebug.activation_step){
    if(greedyDebug.fine){remove_buffered_static_voxels(&greedyDebug.buffer);emit_unit_voxels_from_units(&greedyDebug.buffer,false,true,-1);rebuild_voxel_hash();rebuild_all_voxel_surfaces();rebuild_glue_constraints();}
    else if(!emit_greedy_dynamic_from_buffer(&greedyDebug.buffer))return;memset(greedyDebug.histogram,0,sizeof(greedyDebug.histogram));
    for(int c=0;c<greedyCoarse.group_count;c++){int size=greedyCoarse.sizes[c];if(size<32)greedyDebug.histogram[size]++;}
    for(int i=0;i<greedyCoarse.child_count;i++){int v=greedyCoarse.children[i];if(v<0||v>=voxel_count)continue;int c=greedyCoarse.voxel_group[v];if(c>=0)voxels[v].color=greedy_size_color(greedyCoarse.sizes[c]);}
    rebuild_all_voxel_surfaces();}if(greedyDebug.fracture&&!greedyDebug.fracture_injected&&greedyCoarse.active&&greedyDebug.ticks==70){int fracture_voxel=-1;for(int v=0;v<voxel_count;v++)if(voxels[v].simulate&&voxels[v].orig_min_gx==5&&voxels[v].orig_min_gy==13&&voxels[v].orig_min_gz==1){fracture_voxel=v;break;}if(fracture_voxel>=0){uint64_t id=greedyDebug.fracture_identity=voxels[fracture_voxel].identity;voxels[fracture_voxel].break_mask=(uint8_t)((1u<<1)|(1u<<3)|(1u<<5));voxels[fracture_voxel].wake_source=true;greedyDebug.fracture_injected=greedy_refine_pending_break_masks();fracture_voxel=find_voxel_by_identity(id);if(greedyDebug.fracture_injected&&fracture_voxel>=0){greedyDebug.fracture_pointer_split=!voxels[fracture_voxel].glued_faces[1]&&!voxels[fracture_voxel].glued_faces[3]&&!voxels[fracture_voxel].glued_faces[5];for(int k=0;k<8;k++)voxels[fracture_voxel].particles[k]->vel=v_add(voxels[fracture_voxel].particles[k]->vel,(Vector3){2.0f,1.0f,1.0f});}}}
    if(greedyDebug.fracture&&greedyDebug.fracture_injected){for(int v=0;v<voxel_count;v++)if(voxels[v].simulate&&voxels[v].debugClusterTag==DEBUG_TEST_TAG){int c=greedyCoarse.active&&v<greedyCoarse.voxel_capacity?greedyCoarse.voxel_group[v]:-1;voxels[v].color=c>=0?greedy_size_color(greedyCoarse.sizes[c]):(Color){255,70,55,255};}}
    if((greedyCoarse.active||(greedyDebug.fine&&greedyDebug.ticks>=greedyDebug.activation_step))&&greedyDebug.ticks>greedyDebug.activation_step){greedyDebug.pending_steps++;if(greedyDebug.pending_steps>=debugRunConfig.physics_batch||greedyDebug.ticks==debugRunConfig.steps){double started=GetTime();simulate_voxel_pbd_steps(PBD_MAX_STEP_DT,greedyDebug.pending_steps);greedyDebug.physics_seconds+=GetTime()-started;greedyDebug.physics_steps+=greedyDebug.pending_steps;greedyDebug.pending_steps=0;}}}
static void debug_validate_greedy(DebugRunState *state,int step){if(greedyDebug.fine){if(greedyDebug.ticks>=greedyDebug.activation_step)debug_validate_all_sim_particles(state,step);return;}if(!greedyCoarse.active)return;debug_validate_all_sim_particles(state,step);float dependency=0,miny=FLT_MAX,strain=0;
    for(int i=0;i<greedyCoarse.sample_count;i++){Particle *p=greedyCoarse.samples[i];miny=fminf(miny,p->pos.y);if(greedyDebug.positions)fprintf(greedyDebug.positions,"%d,%d,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g\n",step,i,p->pos.x,p->pos.y,p->pos.z,p->vel.x,p->vel.y,p->vel.z);if(greedyCoarse.source_count[i]>1){Vector3 goal={0};for(int k=0;k<greedyCoarse.source_count[i];k++)goal=v_add(goal,v_mul(greedyCoarse.sources[i][k]->pos,greedyCoarse.weights[i][k]));dependency=fmaxf(dependency,v_length(v_sub(goal,p->pos)));}}
    for(int c=0;c<greedyCoarse.group_count;c++){float a,b;voxel_measure_strain(&greedyCoarse.shapes[c],&a,&b);strain=fmaxf(strain,a);}
    greedyDebug.final_strain=strain;greedyDebug.max_dependency=fmaxf(greedyDebug.max_dependency,dependency);greedyDebug.max_penetration=fmaxf(greedyDebug.max_penetration,fmaxf(0,-miny));greedyDebug.max_strain=fmaxf(greedyDebug.max_strain,strain);
    float dependency_limit=VOXEL_SIZE*(greedyDebug.fracture?2e-5f:1e-5f);if(dependency>dependency_limit)debug_add_failure(state,"greedy dependency error %.9g",dependency);
    if(step==debugRunConfig.steps){if(physics_backend_is_gpu(physicsBackend.active)){int count=0;const Matrix *matrix=gpu_resident_greedy_render_matrices(&count);if(!matrix||count!=greedyCoarse.child_count)debug_add_failure(state,"GPU resident render matrix count %d/%d",count,greedyCoarse.child_count);else for(int n=0;n<count;n++){int child=greedyCoarse.children[n];if(child<0||child>=voxel_count){debug_add_failure(state,"GPU resident render child %d is invalid",child);break;}Voxel *v=&voxels[child];Vector3 center={0};for(int k=0;k<8;k++)center=v_add(center,v->particles[k]->pos);center=v_mul(center,.125f);if(fabsf(matrix[n].m12-center.x)>1e-5f||fabsf(matrix[n].m13-center.y)>1e-5f||fabsf(matrix[n].m14-center.z)>1e-5f){debug_add_failure(state,"GPU resident render matrix %d differs from child state",n);break;}}if(!getenv("FPS_GREEDY_FLOOR_GLOBAL_BATCHES")&&!gpuPhysics.floor_island_fast_path)debug_add_failure(state,"GPU floor island fast path was not used");}if(greedyDebug.fracture){int fine=0;for(int v=0;v<voxel_count;v++)if(voxels[v].debugClusterTag==DEBUG_TEST_TAG)fine+=v>=greedyCoarse.voxel_capacity||greedyCoarse.voxel_group[v]<0;bool broken=greedyDebug.fracture_pointer_split;if(!greedyDebug.fracture_injected)debug_add_failure(state,"scripted fracture did not trigger");if(!greedyCoarse.active)debug_add_failure(state,"fracture materialized the entire greedy body");if(greedyCoarse.child_count>=greedyDebug.buffer.count||fine<=0)debug_add_failure(state,"fracture did not leave a local fine region");if(!broken)debug_add_failure(state,"fracture did not split any pointer face");}else{int distinct=0;for(int i=1;i<32;i++)distinct+=greedyDebug.histogram[i]>0;if(distinct<3)debug_add_failure(state,"greedy cover produced only %d sizes",distinct);}
        if(greedyCoarse.independent_count>=greedyDebug.original_particles)debug_add_failure(state,"greedy cover did not reduce independent particles");if(greedyDebug.max_penetration>VOXEL_SIZE*.02f)debug_add_failure(state,"greedy floor penetration %.9g",greedyDebug.max_penetration);if(greedyDebug.max_strain>.5f)debug_add_failure(state,"greedy transient strain %.9g",greedyDebug.max_strain);if(greedyDebug.final_strain>(greedyDebug.fracture?.06f:.02f))debug_add_failure(state,"greedy final strain %.9g",greedyDebug.final_strain);if(physicsBackend.active==PHYSICS_BACKEND_CPU_MT&&atomic_load(&sizedWorkerCalls)==0)debug_add_failure(state,"greedy CPU MT fixture did not execute a worker job");if(greedyDebug.positions){fclose(greedyDebug.positions);greedyDebug.positions=NULL;}}}
static void debug_report_greedy(FILE *f){if(!greedyFixture)return;fprintf(f,"  \"greedy\": {\"mode\": \"%s\", \"activated\": %s, \"cells\": %d, \"groups\": %d, \"samples\": %d, \"independent\": %d, \"dependent\": %d, \"promotedInterfaces\": %d, \"attachments\": %d, \"fixedStepBatch\": %d, \"floorIslands\": %d, \"floorIslandControls\": %d, \"floorIslandContacts\": %d, \"floorContactBatches\": %d, \"floorIslandFastPath\": %s, \"coverMs\": %.9g, \"physicsSteps\": %d, \"physicsTotalMs\": %.9g, \"physicsMeanMs\": %.9g, \"integrationMs\": %.9g, \"vgsMs\": %.9g, \"dynamicContactMs\": %.9g, \"staticContactMs\": %.9g, \"interfaceRefreshMs\": %.9g, \"passiveRefreshMs\": %.9g, \"maxDependency\": %.9g, \"maxPenetration\": %.9g, \"maxStrain\": %.9g, \"finalStrain\": %.9g, \"workerCalls\": %u, \"histogram\": {",
    greedyDebug.fine?"fine":"greedy",greedyCoarse.active?"true":"false",greedyDebug.buffer.count,greedyCoarse.group_count,greedyDebug.fine?active_particle_count:greedyCoarse.sample_count,greedyDebug.fine?sim_particle_count:greedyCoarse.independent_count,greedyDebug.fine?0:greedyCoarse.sample_count-greedyCoarse.independent_count,greedyDebug.fine?0:greedyCoarse.attachment_count,greedyDebug.fine?0:greedyCoarse.attachment_count,debugRunConfig.physics_batch,gpuPhysics.floor_island_count,gpuPhysics.floor_control_count,gpuPhysics.floor_contact_count,gpuPhysics.static_contact_batch_count,gpuPhysics.floor_island_fast_path?"true":"false",greedyCoarse.cover_ms,greedyDebug.physics_steps,greedyDebug.physics_seconds*1000,greedyDebug.physics_steps?greedyDebug.physics_seconds*1000/greedyDebug.physics_steps:0,greedyStageProfile.integration_ms,greedyStageProfile.vgs_ms,greedyStageProfile.dynamic_ms,greedyStageProfile.static_ms,greedyStageProfile.interface_ms,greedyStageProfile.child_ms,greedyDebug.max_dependency,greedyDebug.max_penetration,greedyDebug.max_strain,greedyDebug.final_strain,atomic_load(&sizedWorkerCalls));
    bool first=true;for(int i=1;i<32;i++)if(greedyDebug.histogram[i]){fprintf(f,"%s\"%d\": %d",first?"":", ",i,greedyDebug.histogram[i]);first=false;}fputs("}},\n",f);}
