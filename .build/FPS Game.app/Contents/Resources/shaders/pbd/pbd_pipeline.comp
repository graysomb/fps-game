#version 430

// Compute implementation of the Jacobi pipeline in fps_ray.c.  The C side
// deliberately supplies explicit particle indices: glued voxels share slots.
layout(local_size_x = 128) in;

struct ParticleState {
    vec4 pos_radius;
    vec4 prev_inv_mass;
    vec4 predicted_base_inv_mass;
    vec4 velocity;
};

struct VoxelState {
    uvec4 particle_0_3;
    uvec4 particle_4_7;
    vec4 pos_rest_edge;
    vec4 velocity_rest_volume;
    ivec4 flags;       // simulate, isBullet, type, simulateDOFs
    vec4 bounds_min;
    vec4 bounds_max;
    uvec4 lifecycle;   // skipVelocityFrames, wakeSource, gluedFaceMask, breakMask
};

struct StaticCollider {
    vec4 center;
    vec4 bounds_min;
    vec4 bounds_max;
};

struct FluidState {
    vec4 density_lambda;
    vec4 delta;
};

struct FluidNeighborData {
    uint count;
    uint neighbors[64];
};

layout(std430, binding = 0) buffer ParticleBuffer { ParticleState particle[]; };
layout(std430, binding = 1) buffer CorrectionBuffer { uvec4 correction[]; };
layout(std430, binding = 2) buffer CellBuffer { ivec4 cell[]; };
layout(std430, binding = 3) buffer SimIdBuffer { uint simId[]; };
layout(std430, binding = 4) buffer VoxelBuffer { VoxelState voxel[]; };
layout(std430, binding = 5) buffer HashHeadBuffer { int hashHead[]; };
layout(std430, binding = 6) buffer HashNextBuffer { int hashNext[]; };
layout(std430, binding = 7) readonly buffer StaticCellBuffer { ivec4 staticCell[]; };
layout(std430, binding = 8) buffer TetherBuffer { int tetherOwner[]; };
layout(std430, binding = 9) buffer CollisionMetaBuffer { ivec4 collisionMeta[]; };
layout(std430, binding = 10) readonly buffer StaticColliderBuffer { StaticCollider staticCollider[]; };
layout(std430, binding = 11) readonly buffer RefcountBuffer { int particleRefcount[]; };
layout(std430, binding = 12) readonly buffer ControlBuffer { ivec4 gpuControl; };
layout(std430, binding = 13) buffer CloneParentBuffer { int cloneParent[]; };
layout(std430, binding = 14) buffer DispatchBuffer { uint dispatchArgs[]; };
layout(std430, binding = 15) buffer TopologyBuffer { ivec4 topology[]; };
layout(std430, binding = 16) buffer FluidBuffer { FluidState fluid[]; };
layout(std430, binding = 17) buffer FluidNeighborBuffer { FluidNeighborData fluidNeighbors[]; };

uniform int uMode;
uniform int uParticleCount;
uniform int uSimCount;
uniform int uFluidCount;
uniform int uVoxelCount;
uniform int uStaticColliderCount;
uniform int uHashSize;
uniform int uStaticHashSize;
uniform int uActivePlayers;
uniform float uDt;
uniform float uVoxelSize;
uniform float uFloorSize;
uniform float uGravity;
uniform float uVelocityDamping;
uniform float uSor;
uniform float uCollisionRelaxation;
uniform float uVgsAlpha;
uniform float uVgsBeta;
uniform float uVgsEpsilon;
uniform float uStrainBreakThreshold;
uniform float uShearBreakThreshold;
uniform float uTetherSpring;
uniform float uTetherDamping;
uniform int uBreakDampFrames;
uniform float uRestGridStep;
uniform vec4 uPlayerPosHalf[4]; // xyz position, w < 0 when inactive
uniform vec4 uTetherTarget[4];

const int MODE_RESET = 0;
const int MODE_INTEGRATE = 1;
const int MODE_HASH_CLEAR = 2;
const int MODE_HASH_BUILD = 3;
const int MODE_SCENE_COLLISIONS = 4;
const int MODE_PAIR_COLLISIONS = 5;
const int MODE_APPLY = 6;
const int MODE_VGS = 7;
const int MODE_STATIC_COLLISIONS = 8;
const int MODE_BREAK_MASK = 9;
const int MODE_FINALIZE_PARTICLES = 10;
const int MODE_FINALIZE_VOXELS = 11;
const int MODE_SPLIT_BREAKS = 12;
const int MODE_PREPARE_INDIRECT = 13;
const int MODE_WAKE_GATHER = 14;
const int MODE_WAKE_APPLY = 15;
const int MODE_TOPOLOGY_REBUILD_SERIAL = 16;
const int MODE_PBF_BUILD_NEIGHBORS = 17;
const int MODE_PBF_LAMBDA = 18;
const int MODE_PBF_DELTA = 19;
const int MODE_PBF_APPLY = 20;
const int MODE_PBF_STATIC_COLLISIONS = 21;
const int MODE_PBF_DYNAMIC_SOLID_COLLISIONS = 22;
const int MODE_PBF_DYNAMIC_SOLID_FINAL = 23;
const int MODE_PBF_VISCOSITY = 24;
const int MODE_PBF_APPLY_VISCOSITY = 25;
const int CONTROL_FLAG_OVERFLOW = 1;
const int CONTROL_FLAG_TOPOLOGY_DIRTY = 2;
const int CONTROL_FLAG_BREAK_OCCURRED = 4;
const uint PBF_MAX_NEIGHBORS = 64u;
const float PARTICLE_MATERIAL_FLUID = 1.0;

bool isFluid(ParticleState p) {
    return abs(p.velocity.w - PARTICLE_MATERIAL_FLUID) < 0.25;
}

uint fluidId(uint gid) {
    return simId[uint(uSimCount) + gid];
}

uint voxelParticle(VoxelState v, int corner) {
    return (corner < 4) ? v.particle_0_3[corner] : v.particle_4_7[corner - 4];
}

uint hashCoord(ivec3 c, int size) {
    uint h = uint(c.x) * 73856093u;
    h ^= uint(c.y) * 19349663u;
    h ^= uint(c.z) * 83492791u;
    return h & uint(size - 1);
}

void atomicAddCorrection(uint id, int component, float value) {
    if (value == 0.0) return;
    uint expected = correction[id][component];
    for (;;) {
        float current = uintBitsToFloat(expected);
        uint desired = floatBitsToUint(current + value);
        uint observed = atomicCompSwap(correction[id][component], expected, desired);
        if (observed == expected) return;
        expected = observed;
    }
}

void accumulate(uint id, vec3 delta, float weight) {
    if (weight <= 0.0 || id >= uint(gpuControl.x)) return;
    atomicAddCorrection(id, 0, delta.x * weight);
    atomicAddCorrection(id, 1, delta.y * weight);
    atomicAddCorrection(id, 2, delta.z * weight);
    atomicAddCorrection(id, 3, weight);
}

vec3 projectOnto(vec3 onto, vec3 value) {
    float denom = dot(onto, onto);
    return (denom < uVgsEpsilon) ? vec3(0.0) : onto * (dot(onto, value) / denom);
}

void resetCorrections(uint gid) {
    if (gid >= uint(gpuControl.y)) return;
    uint id = simId[gid];
    if (particleRefcount[id] <= 0) return;
    correction[id] = uvec4(0u);
}

void integrateParticle(uint gid) {
    if (gid >= uint(gpuControl.y)) return;
    uint id = simId[gid];
    if (particleRefcount[id] <= 0) return;
    ParticleState p = particle[id];
    p.prev_inv_mass.xyz = p.pos_radius.xyz;
    p.predicted_base_inv_mass.xyz = p.pos_radius.xyz;
    if (p.prev_inv_mass.w > 0.0) {
        p.velocity.xyz *= uVelocityDamping;
        p.predicted_base_inv_mass.xyz += p.velocity.xyz * uDt;
        p.predicted_base_inv_mass.y -= uGravity * uDt * uDt;
        int tetherPlayer = tetherOwner[id];
        if (tetherPlayer >= 0 && tetherPlayer < 4) {
            float scale = uTetherTarget[tetherPlayer].w;
            vec3 accel = uTetherTarget[tetherPlayer].xyz * uTetherSpring * scale;
            p.predicted_base_inv_mass.xyz += accel * uDt * uDt;
            p.velocity.xyz += accel * uDt;
            float damp = clamp(uTetherDamping * scale * uDt, 0.0, 0.9);
            vec3 disp = p.predicted_base_inv_mass.xyz - p.prev_inv_mass.xyz;
            p.predicted_base_inv_mass.xyz = p.prev_inv_mass.xyz + disp * (1.0 - damp);
            p.velocity.xyz *= 1.0 - damp;
        }
    }
    particle[id] = p;
}

void clearHash(uint gid) {
    if (gid < uint(uHashSize)) hashHead[gid] = -1;
}

void buildHash(uint gid) {
    if (gid >= dispatchArgs[8]) return;
    uint id = simId[uint(gpuControl.z) + gid];
    if (particleRefcount[id] <= 0) return;
    ivec3 c = ivec3(floor(particle[id].predicted_base_inv_mass.xyz / uVoxelSize));
    cell[id].xyz = c;
    uint h = hashCoord(c, uHashSize);
    hashNext[gid] = atomicExchange(hashHead[h], int(gid));
}

void pairCollisions(uint gid) {
    if (gid >= dispatchArgs[8]) return;
    uint aid = simId[uint(gpuControl.z) + gid];
    if (particleRefcount[aid] <= 0) return;
    ParticleState a = particle[aid];
    if (isFluid(a)) return;
    float wa = a.prev_inv_mass.w;
    if (wa <= 0.0) return;
    const float eps = 1e-6;

    vec3 scenePos = a.predicted_base_inv_mass.xyz;
    float sceneRadius = a.pos_radius.w;
    for (int playerIndex = 0; playerIndex < uActivePlayers && playerIndex < 4; ++playerIndex) {
        if (uPlayerPosHalf[playerIndex].w < 0.0) continue;
        float halfSize = uPlayerPosHalf[playerIndex].w;
        vec3 nearest = clamp(scenePos, uPlayerPosHalf[playerIndex].xyz - vec3(halfSize),
                                      uPlayerPosHalf[playerIndex].xyz + vec3(halfSize));
        vec3 sceneDelta = scenePos - nearest;
        float sceneDistSq = dot(sceneDelta, sceneDelta);
        if (sceneDistSq < sceneRadius * sceneRadius) {
            float sceneDist = sqrt(max(sceneDistSq, eps));
            float penetration = sceneRadius - sceneDist;
            vec3 normal = (sceneDist > eps) ? -sceneDelta / sceneDist : vec3(0.0, 1.0, 0.0);
            scenePos += normal * penetration;
        }
    }
    accumulate(aid, scenePos - a.predicted_base_inv_mass.xyz, 1.0);

    ivec3 ac = cell[aid].xyz;
    for (int dz = -1; dz <= 1; ++dz) {
        for (int dy = -1; dy <= 1; ++dy) {
            for (int dx = -1; dx <= 1; ++dx) {
                if (dz < 0 || (dz == 0 && dy < 0) ||
                    (dz == 0 && dy == 0 && dx < 0)) continue;
                ivec3 nc = ac + ivec3(dx, dy, dz);
                int item = hashHead[hashCoord(nc, uHashSize)];
                int traversed = 0;
                while (item >= 0 && item < int(dispatchArgs[8]) && traversed < int(dispatchArgs[8])) {
                    ++traversed;
                    bool sameCell = (dx == 0 && dy == 0 && dz == 0);
                    if (!sameCell || uint(item) > gid) {
                            uint bid = simId[uint(gpuControl.z) + uint(item)];
                            if (particleRefcount[bid] <= 0 || isFluid(particle[bid])) { item = hashNext[item]; continue; }
                        if (all(equal(cell[bid].xyz, nc))) {
                            ParticleState b = particle[bid];
                            ivec4 metaA = collisionMeta[aid];
                            ivec4 metaB = collisionMeta[bid];
                            if (metaA.w >= 0 && metaA.w == metaB.w) {
                                vec3 restDelta = vec3(metaA.xyz - metaB.xyz) * uRestGridStep;
                                float restTarget = a.pos_radius.w + b.pos_radius.w + 1e-5;
                                if (dot(restDelta, restDelta) <= restTarget * restTarget) {
                                    item = hashNext[item];
                                    continue;
                                }
                            }
                            float wb = b.prev_inv_mass.w;
                            float wsum = wa + wb;
                            vec3 delta = a.predicted_base_inv_mass.xyz - b.predicted_base_inv_mass.xyz;
                            float distSq = dot(delta, delta);
                            float target = a.pos_radius.w + b.pos_radius.w;
                            if (wsum > 0.0 && distSq < target * target) {
                                float dist = sqrt(max(distSq, eps));
                                float penetration = target - dist;
                                if (penetration > 0.0) {
                                    vec3 normal = (dist > eps) ? delta / dist : vec3(1.0, 0.0, 0.0);
                                    float scale = uCollisionRelaxation * (0.5 * penetration) / wsum;
                                    int maxTimer = max(cell[aid].w, cell[bid].w);
                                    float damp = (uBreakDampFrames > 0)
                                        ? clamp(1.0 - float(maxTimer) / float(uBreakDampFrames), 0.0, 1.0)
                                        : 1.0;
                                    if (wa > 0.0) accumulate(aid, normal * (scale * wa * damp), 1.0);
                                    if (wb > 0.0) accumulate(bid, normal * (-scale * wb * damp), 1.0);
                                }
                            }
                        }
                    }
                    item = hashNext[item];
                }
                if (item >= 0 && item < int(dispatchArgs[8])) atomicAdd(dispatchArgs[11], 1u);
            }
        }
    }
}

void applyCorrections(uint gid) {
    if (gid >= uint(gpuControl.y)) return;
    uint id = simId[gid];
    if (particleRefcount[id] <= 0) return;
    uvec4 bits = correction[id];
    float weight = uintBitsToFloat(bits.w);
    if (weight > 0.0) {
        vec3 sum = vec3(uintBitsToFloat(bits.x), uintBitsToFloat(bits.y), uintBitsToFloat(bits.z));
        particle[id].predicted_base_inv_mass.xyz += sum * (uSor / weight);
    }
    correction[id] = uvec4(0u);
}

void solveVgs(uint gid) {
    if (gid >= uint(uVoxelCount)) return;
    VoxelState v = voxel[gid];
    if (v.flags.x == 0 || v.flags.y != 0 || v.flags.z != 0 || v.flags.w == 0) return;
    vec3 p[8];
    vec3 original[8];
    float applyWeight[8];
    bool dynamicParticle = false;
    for (int i = 0; i < 8; ++i) {
        uint id = voxelParticle(v, i);
        if (id >= uint(gpuControl.x)) return;
        p[i] = particle[id].predicted_base_inv_mass.xyz;
        original[i] = p[i];
        float w = particle[id].prev_inv_mass.w;
        applyWeight[i] = (w > 0.0) ? w : 0.0;
        dynamicParticle = dynamicParticle || (w > 0.0);
    }
    if (!dynamicParticle) return;

    float restEdge = v.pos_rest_edge.w;
    float restVolume = v.velocity_rest_volume.w;
    for (int iteration = 0; iteration < 3; ++iteration) {
        vec3 centerPos = vec3(0.0);
        for (int i = 0; i < 8; ++i) centerPos += p[i];
        centerPos *= 0.125;
        vec3 v0 = ((p[1]-p[0]) + (p[3]-p[2]) + (p[5]-p[4]) + (p[7]-p[6])) * 0.25;
        vec3 v1 = ((p[2]-p[0]) + (p[3]-p[1]) + (p[6]-p[4]) + (p[7]-p[5])) * 0.25;
        vec3 v2 = ((p[4]-p[0]) + (p[5]-p[1]) + (p[6]-p[2]) + (p[7]-p[3])) * 0.25;
        vec3 u0 = v0 - uVgsAlpha * (projectOnto(v1, v0) + projectOnto(v2, v0));
        vec3 u1 = v1 - uVgsAlpha * (projectOnto(v2, v1) + projectOnto(v0, v1));
        vec3 u2 = v2 - uVgsAlpha * (projectOnto(v0, v2) + projectOnto(v1, v2));
        float target0 = mix(restEdge, length(v0), uVgsBeta);
        float target1 = mix(restEdge, length(v1), uVgsBeta);
        float target2 = mix(restEdge, length(v2), uVgsBeta);
        if (length(u0) > uVgsEpsilon) u0 *= target0 / length(u0);
        if (length(u1) > uVgsEpsilon) u1 *= target1 / length(u1);
        if (length(u2) > uVgsEpsilon) u2 *= target2 / length(u2);
        float volume = dot(cross(u0, u1), u2);
        if (abs(volume) > uVgsEpsilon) {
            float scale = restVolume / volume;
            float root = pow(abs(scale), 1.0/3.0) * ((scale < 0.0) ? -1.0 : 1.0);
            u0 *= 0.5 * root; u1 *= 0.5 * root; u2 *= 0.5 * root;
        }
        vec3 nextP[8];
        nextP[0]=centerPos-u0-u1-u2; nextP[1]=centerPos+u0-u1-u2;
        nextP[2]=centerPos-u0+u1-u2; nextP[3]=centerPos+u0+u1-u2;
        nextP[4]=centerPos-u0-u1+u2; nextP[5]=centerPos+u0-u1+u2;
        nextP[6]=centerPos-u0+u1+u2; nextP[7]=centerPos+u0+u1+u2;
        for (int i = 0; i < 8; ++i) p[i] = nextP[i];
    }
    for (int i = 0; i < 8; ++i) {
        if (applyWeight[i] > 0.0) accumulate(voxelParticle(v, i), p[i] - original[i], applyWeight[i]);
    }
}

int findStaticCell(ivec3 coord) {
    uint h = hashCoord(coord, uStaticHashSize);
    for (int probe = 0; probe < uStaticHashSize; ++probe) {
        ivec4 entry = staticCell[h];
        if (entry.w == -1) return -1;
        if (all(equal(entry.xyz, coord))) return entry.w;
        h = (h + 1u) & uint(uStaticHashSize - 1);
    }
    return -1;
}

vec3 pushOutOfBox(vec3 pos, float radius, StaticCollider box) {
    vec3 bmin = box.bounds_min.xyz;
    vec3 bmax = box.bounds_max.xyz;
    bool inside = all(greaterThanEqual(pos, bmin)) && all(lessThanEqual(pos, bmax));
    const float eps = 1e-6;
    if (!inside) {
        vec3 closest = clamp(pos, bmin, bmax);
        vec3 delta = pos - closest;
        float distSq = dot(delta, delta);
        if (distSq >= radius * radius) return pos;
        float dist = sqrt(max(distSq, eps));
        float penetration = radius - dist;
        vec3 normal = (dist > eps) ? delta / dist : vec3(0.0, 1.0, 0.0);
        return pos + normal * max(penetration, 0.0);
    }
    float topGap = bmax.y - pos.y;
    float bottomGap = pos.y - bmin.y;
    float verticalBias = uVoxelSize * 0.25;
    bool preferTop = (pos.y >= box.center.y) && (topGap <= radius + verticalBias);
    bool preferBottom = (pos.y < box.center.y) && (bottomGap <= radius + verticalBias);
    if (preferTop || preferBottom) {
        bool top = preferTop && (!preferBottom || topGap <= bottomGap);
        vec3 normal = top ? vec3(0.0, 1.0, 0.0) : vec3(0.0, -1.0, 0.0);
        float gap = top ? topGap : bottomGap;
        float penetration = radius - gap;
        if (penetration < 0.0) penetration = radius;
        return pos + normal * penetration;
    }
    vec3 low = pos - bmin;
    vec3 high = bmax - pos;
    float distances[6] = float[6](low.x, high.x, low.y, high.y, low.z, high.z);
    int best = 0;
    for (int i = 1; i < 6; ++i) if (distances[i] < distances[best]) best = i;
    vec3 normal = vec3(0.0);
    if (best == 0) normal.x=-1.0; else if (best == 1) normal.x=1.0;
    else if (best == 2) normal.y=-1.0; else if (best == 3) normal.y=1.0;
    else if (best == 4) normal.z=-1.0; else normal.z=1.0;
    return pos + normal * (radius + distances[best]);
}

vec3 pushOutOfPatch(vec3 pos, float radius, StaticCollider surfacePatch) {
    vec3 closest = clamp(pos, surfacePatch.bounds_min.xyz, surfacePatch.bounds_max.xyz);
    vec3 normal = surfacePatch.center.xyz;
    vec3 delta = pos - closest;
    float signedDistance = dot(delta, normal);
    bool projectedInside;
    if (normal.x != 0.0) projectedInside = pos.y >= surfacePatch.bounds_min.y && pos.y <= surfacePatch.bounds_max.y && pos.z >= surfacePatch.bounds_min.z && pos.z <= surfacePatch.bounds_max.z;
    else if (normal.y != 0.0) projectedInside = pos.x >= surfacePatch.bounds_min.x && pos.x <= surfacePatch.bounds_max.x && pos.z >= surfacePatch.bounds_min.z && pos.z <= surfacePatch.bounds_max.z;
    else projectedInside = pos.x >= surfacePatch.bounds_min.x && pos.x <= surfacePatch.bounds_max.x && pos.y >= surfacePatch.bounds_min.y && pos.y <= surfacePatch.bounds_max.y;
    if (projectedInside && signedDistance < 0.0 && signedDistance >= -radius) return pos + normal * (radius - signedDistance);
    if (signedDistance < 0.0) return pos;
    float distanceSq = dot(delta, delta);
    if (distanceSq >= radius * radius) return pos;
    float distance = sqrt(max(distanceSq, 1e-6));
    vec3 direction = distance > 1e-6 ? delta / distance : normal;
    return pos + direction * (radius - distance);
}

void staticCollisionParticleDirect(uint id) {
    ParticleState p = particle[id];
    if (p.prev_inv_mass.w <= 0.0) return;
    float radius = p.pos_radius.w;
    vec3 pos = p.predicted_base_inv_mass.xyz;
    float terrainLimit = uFloorSize - radius;
    float floorLimit = max(0.0, 0.5 * uVoxelSize - radius);
    bool floorContact = pos.y < floorLimit;
    pos.y = max(pos.y, floorLimit);
    if (floorContact) p.prev_inv_mass.xz = pos.xz -
        (pos.xz - p.prev_inv_mass.xz) * 0.05;
    pos.xz = clamp(pos.xz, vec2(-terrainLimit), vec2(terrainLimit));
    const float eps = 1e-6;
    for (int i = 0; i < uActivePlayers && i < 4; ++i) {
        if (uPlayerPosHalf[i].w < 0.0) continue;
        float halfSize = uPlayerPosHalf[i].w;
        vec3 nearest = clamp(pos, uPlayerPosHalf[i].xyz - vec3(halfSize),
                                  uPlayerPosHalf[i].xyz + vec3(halfSize));
        vec3 delta = pos - nearest;
        float distSq = dot(delta, delta);
        if (distSq < radius * radius) {
            float dist = sqrt(max(distSq, eps));
            vec3 normal = (dist > eps) ? delta / dist : vec3(0.0, 1.0, 0.0);
            pos += normal * (radius - dist);
        }
    }
    ivec3 center = ivec3(floor(pos / uVoxelSize));
    int seen[128]; int seenCount = 0;
    for (int z=-1; z<=1; ++z) for (int y=-1; y<=1; ++y) for (int x=-1; x<=1; ++x) {
        int item = findStaticCell(center + ivec3(x,y,z));
        if (dispatchArgs[12] == 0u && item <= -2) {
            int colliderId = -item - 2;
            if (colliderId >= 0 && colliderId < uStaticColliderCount)
                pos = pushOutOfBox(pos, 0.25 * uVoxelSize, staticCollider[colliderId]);
            continue;
        }
        while (item >= 0 && item < uStaticColliderCount) {
            StaticCollider surfacePatch = staticCollider[item];
            int patchId = floatBitsToInt(surfacePatch.bounds_min.w);
            bool duplicate = false;
            for (int s=0; s<seenCount; ++s) duplicate = duplicate || (seen[s] == patchId);
            if (!duplicate && seenCount < 128) {
                seen[seenCount++] = patchId;
                pos = pushOutOfPatch(pos, 0.25 * uVoxelSize, surfacePatch);
            }
            item = floatBitsToInt(surfacePatch.center.w);
        }
    }
    center = ivec3(floor(pos / uVoxelSize));
    int recovery = findStaticCell(center);
    if (recovery <= -2) {
        int colliderId = -recovery - 2;
        if (colliderId >= 0 && colliderId < uStaticColliderCount)
            pos = pushOutOfBox(pos, 0.25 * uVoxelSize, staticCollider[colliderId]);
    }
    p.predicted_base_inv_mass.xyz = pos;
    particle[id] = p;
}

void staticCollisions(uint gid) {
    if (gid >= dispatchArgs[8]) return;
    uint id = simId[uint(gpuControl.z) + gid];
    if (particleRefcount[id] <= 0 || isFluid(particle[id])) return;
    staticCollisionParticleDirect(id);
}

int topologyNeighbor(int voxelId, int face);

void gatherBreakMask(uint gid) {
    if (gid >= uint(uVoxelCount)) return;
    VoxelState v = voxel[gid];
    if (v.flags.x == 0 || v.flags.y != 0 || v.flags.z != 0 || v.pos_rest_edge.w <= 0.0) {
        voxel[gid] = v; return;
    }
    vec3 p[8];
    for (int i=0; i<8; ++i) {
        uint id=voxelParticle(v,i); if (id>=uint(gpuControl.x)) return;
        p[i]=particle[id].predicted_base_inv_mass.xyz;
    }
    vec3 axis0=((p[1]-p[0])+(p[3]-p[2])+(p[5]-p[4])+(p[7]-p[6]))*0.25;
    vec3 axis1=((p[2]-p[0])+(p[3]-p[1])+(p[6]-p[4])+(p[7]-p[5]))*0.25;
    vec3 axis2=((p[4]-p[0])+(p[5]-p[1])+(p[6]-p[2])+(p[7]-p[3]))*0.25;
    vec3 lengths=vec3(length(axis0),length(axis1),length(axis2));
    vec3 strain=abs(lengths-vec3(v.pos_rest_edge.w))/v.pos_rest_edge.w;
    uint glued=v.lifecycle.z; uint mask=0u; bool exceeded=false;
    if (strain.x>uStrainBreakThreshold) { exceeded=true; mask |= glued & ((1u<<0)|(1u<<1)); }
    if (strain.y>uStrainBreakThreshold) { exceeded=true; mask |= glued & ((1u<<2)|(1u<<3)); }
    if (strain.z>uStrainBreakThreshold) { exceeded=true; mask |= glued & ((1u<<4)|(1u<<5)); }
    vec3 n0=(lengths.x>uVgsEpsilon)?axis0/lengths.x:vec3(0.0);
    vec3 n1=(lengths.y>uVgsEpsilon)?axis1/lengths.y:vec3(0.0);
    vec3 n2=(lengths.z>uVgsEpsilon)?axis2/lengths.z:vec3(0.0);
    if (abs(dot(n0,n1))>uShearBreakThreshold) { exceeded=true; mask |= glued & ((1u<<4)|(1u<<5)); }
    if (abs(dot(n0,n2))>uShearBreakThreshold) { exceeded=true; mask |= glued & ((1u<<2)|(1u<<3)); }
    if (abs(dot(n1,n2))>uShearBreakThreshold) { exceeded=true; mask |= glued & ((1u<<0)|(1u<<1)); }
    const float hingeCosLimit = 0.9396926208; // cos(20 degrees)
    const int faceCorners[24] = int[24](
        1,3,5,7, 0,2,4,6, 2,3,6,7,
        0,1,4,5, 4,5,6,7, 0,1,2,3);
    for (int face=0; face<6; ++face) {
        if ((glued & (1u<<face)) == 0u) continue;
        int sharedCornerCount = 0;
        for (int c=0; c<4; ++c) {
            uint sharedId = voxelParticle(v, faceCorners[face*4+c]);
            if (sharedId < uint(gpuControl.x) && particleRefcount[sharedId] > 1)
                ++sharedCornerCount;
        }
        if (sharedCornerCount > 1) continue;
        int neighborId = topologyNeighbor(int(gid), face);
        if (neighborId < 0 || neighborId >= uVoxelCount) continue;
        VoxelState neighbor = voxel[neighborId];
        if (neighbor.flags.x == 0 || neighbor.flags.y != 0 || neighbor.flags.z != 0) continue;
        vec3 q[8];
        for (int i=0; i<8; ++i) {
            uint id=voxelParticle(neighbor,i); if (id>=uint(gpuControl.x)) return;
            q[i]=particle[id].predicted_base_inv_mass.xyz;
        }
        vec3 m0=normalize(((q[1]-q[0])+(q[3]-q[2])+(q[5]-q[4])+(q[7]-q[6]))*0.25);
        vec3 m1=normalize(((q[2]-q[0])+(q[3]-q[1])+(q[6]-q[4])+(q[7]-q[5]))*0.25);
        vec3 m2=normalize(((q[4]-q[0])+(q[5]-q[1])+(q[6]-q[2])+(q[7]-q[3]))*0.25);
        if (dot(n0,m0)<hingeCosLimit || dot(n1,m1)<hingeCosLimit || dot(n2,m2)<hingeCosLimit) {
            exceeded=true; mask |= 1u<<face;
        }
    }
    if (exceeded) {
        v.flags.x = 0; // Deactivate VGS constraint
        v.lifecycle.y = 1u; // wake_source = true
        v.lifecycle.z = 0u; // Clear glued faces
    }
    voxel[gid] = v;
}

void splitBrokenFaces(uint gid) {
    // No-op in VGS-as-glue model: fracture never splits or clones particles.
}

int topologyNeighbor(int voxelId, int face) {
    return (face < 4) ? topology[voxelId * 2][face]
                      : topology[voxelId * 2 + 1][face - 4];
}

int topologyRoot(int voxelId) {
    int root = voxelId;
    for (int i = 0; i < 32; ++i) {
        int parent = topology[root * 2 + 1].z;
        if (parent == root || parent < 0 || parent >= uVoxelCount) break;
        root = parent;
    }
    return root;
}

void topologyUnion(uint gid) {
    if ((gpuControl.w & CONTROL_FLAG_TOPOLOGY_DIRTY) == 0 || gid >= uint(uVoxelCount)) return;
    VoxelState v = voxel[gid];
    if ((v.lifecycle.z & 0x80000000u) == 0u) return;
    for (int face = 0; face < 6; ++face) {
        if ((v.lifecycle.z & (1u << face)) == 0u) continue;
        int neighbor = topologyNeighbor(int(gid), face);
        if (neighbor < 0 || neighbor >= uVoxelCount) continue;
        if ((voxel[neighbor].lifecycle.z & 0x80000000u) == 0u) continue;
        for (int attempt = 0; attempt < 32; ++attempt) {
            int a = topologyRoot(int(gid));
            int b = topologyRoot(neighbor);
            if (a == b) break;
            int high = max(a, b), low = min(a, b);
            int old = atomicCompSwap(topology[high * 2 + 1].z, high, low);
            if (old == high || old == low) break;
        }
    }
}

void assignParticleGroup(uint id, int group) {
    for (;;) {
        int old = collisionMeta[id].w;
        if (old == group || old == -2) return;
        int next = (old == -1) ? group : -2;
        if (atomicCompSwap(collisionMeta[id].w, old, next) == old) return;
    }
}

void topologyAssignParticles(uint gid) {
    if ((gpuControl.w & CONTROL_FLAG_TOPOLOGY_DIRTY) == 0 || gid >= uint(uVoxelCount)) return;
    VoxelState v = voxel[gid];
    if ((v.lifecycle.z & 0x80000000u) == 0u || v.flags.y != 0 || v.flags.z != 0) return;
    int group = topologyRoot(int(gid));
    for (int corner = 0; corner < 8; ++corner) {
        uint id = voxelParticle(v, corner);
        if (id < uint(gpuControl.x) && particleRefcount[id] > 0 &&
            particle[id].predicted_base_inv_mass.w > 0.0) assignParticleGroup(id, group);
    }
}

void topologyRebuildSerial(uint gid) {
    // No-op matching Metal pipeline: topology rebuild is handled via resident graph updates.
}

void wakeGather(uint gid) {
    if (gid >= uint(uVoxelCount)) return;
    VoxelState v = voxel[gid];
    if (v.flags.x == 0 || v.flags.y != 0) return;
    bool wake = v.lifecycle.y != 0u;
    if (!wake) {
        for (int face = 0; face < 6; ++face) {
            int neighbor = topologyNeighbor(int(gid), face);
            if (neighbor >= 0 && neighbor < uVoxelCount && voxel[neighbor].flags.y == 0 &&
                voxel[neighbor].lifecycle.y != 0u) { wake = true; break; }
        }
    }
    int timer = max(int(v.bounds_min.w) - 1, 0);
    if (wake) timer = 30;
    v.bounds_min.w = float(timer);
    voxel[gid] = v;
}

void wakeApply(uint gid) {
    // No-op: wakeGather writes directly to bounds_min.w
}

void prepareIndirect(uint gid) {
    if (gid != 0u) return;
    dispatchArgs[0] = (uint(max(gpuControl.y, 0)) + 127u) / 128u;
    dispatchArgs[1] = 1u;
    dispatchArgs[2] = 1u;
    dispatchArgs[3] = 0u;
    dispatchArgs[4] = (dispatchArgs[8] + 127u) / 128u;
    dispatchArgs[5] = 1u;
    dispatchArgs[6] = 1u;
    dispatchArgs[7] = 0u;
}

void finalizeParticle(uint gid) {
    if (gid >= uint(gpuControl.y)) return;
    uint id=simId[gid]; ParticleState p=particle[id];
    if (particleRefcount[id] <= 0) return;
    vec3 delta=p.predicted_base_inv_mass.xyz-p.prev_inv_mass.xyz;
    p.velocity.xyz=(p.prev_inv_mass.w>0.0 && uDt>0.0)?delta/uDt:vec3(0.0);
    p.pos_radius.xyz=p.predicted_base_inv_mass.xyz;
    if (cell[id].w>0) cell[id].w--;
    particle[id]=p;
}

void finalizeVoxel(uint gid) {
    if (gid >= uint(uVoxelCount)) return;
    VoxelState v=voxel[gid];
    if (v.flags.x==0 || v.flags.y!=0 || v.flags.z!=0) return;
    vec3 centerPos=vec3(0.0), previous=vec3(0.0);
    for (int i=0;i<8;++i) {
        uint id=voxelParticle(v,i); if(id>=uint(gpuControl.x)) return;
        centerPos+=particle[id].predicted_base_inv_mass.xyz;
        previous+=particle[id].prev_inv_mass.xyz;
    }
    centerPos*=0.125; previous*=0.125;
    if (v.lifecycle.x==0u && uDt>0.0) v.velocity_rest_volume.xyz=(centerPos-previous)/uDt;
    else if (v.lifecycle.x>0u) v.lifecycle.x--;
    v.pos_rest_edge.xyz=centerPos; voxel[gid]=v;
}

float pbfPoly6(float distanceSq, float h, float poly6Coeff) {
    float hSq = h * h;
    if (distanceSq < 0.0 || distanceSq >= hSq) return 0.0;
    float term = hSq - distanceSq;
    return poly6Coeff * term * term * term;
}

vec3 pbfSpikyGradient(vec3 separation, float h, float spikyCoeff) {
    float distanceSq = dot(separation, separation);
    if (distanceSq <= 1e-12 || distanceSq >= h * h) return vec3(0.0);
    float distance = sqrt(distanceSq);
    float term = h - distance;
    return separation * (spikyCoeff * term * term / distance);
}

void pbfBuildNeighbors(uint gid) {
    if (gid >= uint(uFluidCount)) return;
    uint id = fluidId(gid);
    ivec3 currentCell = cell[id].xyz;
    uint count = 0u;
    float h = uVoxelSize;
    float hSq = h * h;
    for (int dz = -1; dz <= 1; ++dz) for (int dy = -1; dy <= 1; ++dy) for (int dx = -1; dx <= 1; ++dx) {
        ivec3 neighborCell = currentCell + ivec3(dx, dy, dz);
        int item = hashHead[hashCoord(neighborCell, uHashSize)];
        int traversed = 0;
        while (item >= 0 && traversed < int(dispatchArgs[8])) {
            ++traversed;
            uint candidate = simId[uint(gpuControl.z) + uint(item)];
            if (isFluid(particle[candidate]) && all(equal(cell[candidate].xyz, neighborCell))) {
                vec3 sep = particle[id].predicted_base_inv_mass.xyz - particle[candidate].predicted_base_inv_mass.xyz;
                if (dot(sep, sep) < hSq) {
                    if (count < PBF_MAX_NEIGHBORS) {
                        fluidNeighbors[gid].neighbors[count] = candidate;
                    }
                    count++;
                }
            }
            item = hashNext[item];
        }
    }
    fluidNeighbors[gid].count = count;
}

void pbfLambda(uint gid) {
    if (gid >= uint(uFluidCount)) return;
    uint id = fluidId(gid);
    ParticleState current = particle[id];
    float h = uVoxelSize;
    float spacing = uVoxelSize * 0.5;
    float restDensity = 1000.0;
    float particleMass = restDensity * spacing * spacing * spacing;
    float h2 = h * h, h6 = h2 * h2 * h2, h9 = h6 * h2 * h;
    float poly6Coeff = 315.0 / (64.0 * 3.14159265358979323846 * h9);
    float spikyCoeff = -45.0 / (3.14159265358979323846 * h6);
    float volume = particleMass / restDensity;
    float lambdaEpsilon = 1e-6;

    float density = 0.0;
    vec3 gradientI = vec3(0.0);
    float gradientSumSq = 0.0;
    uint cachedCount = fluidNeighbors[gid].count;
    if (cachedCount <= PBF_MAX_NEIGHBORS) {
        for (uint k = 0u; k < cachedCount; ++k) {
            uint neighbor = fluidNeighbors[gid].neighbors[k];
            vec3 sep = current.predicted_base_inv_mass.xyz - particle[neighbor].predicted_base_inv_mass.xyz;
            density += particleMass * pbfPoly6(dot(sep, sep), h, poly6Coeff);
            if (neighbor != id) {
                vec3 gradientJ = -volume * pbfSpikyGradient(sep, h, spikyCoeff);
                gradientSumSq += dot(gradientJ, gradientJ);
                gradientI -= gradientJ;
            }
        }
    } else {
        ivec3 currentCell = cell[id].xyz;
        for (int dz = -1; dz <= 1; ++dz) for (int dy = -1; dy <= 1; ++dy) for (int dx = -1; dx <= 1; ++dx) {
            ivec3 neighborCell = currentCell + ivec3(dx, dy, dz);
            int item = hashHead[hashCoord(neighborCell, uHashSize)];
            int traversed = 0;
            while (item >= 0 && traversed < int(dispatchArgs[8])) {
                ++traversed;
                uint neighbor = simId[uint(gpuControl.z) + uint(item)];
                if (isFluid(particle[neighbor]) && all(equal(cell[neighbor].xyz, neighborCell))) {
                    vec3 sep = current.predicted_base_inv_mass.xyz - particle[neighbor].predicted_base_inv_mass.xyz;
                    float distSq = dot(sep, sep);
                    if (distSq < h * h) {
                        density += particleMass * pbfPoly6(distSq, h, poly6Coeff);
                        if (neighbor != id) {
                            vec3 gradientJ = -volume * pbfSpikyGradient(sep, h, spikyCoeff);
                            gradientSumSq += dot(gradientJ, gradientJ);
                            gradientI -= gradientJ;
                        }
                    }
                }
                item = hashNext[item];
            }
        }
    }
    gradientSumSq += dot(gradientI, gradientI);
    float constraint = density / restDensity - 1.0;
    fluid[id].density_lambda.x = density;
    fluid[id].density_lambda.y = -constraint / (gradientSumSq + lambdaEpsilon);
}

void pbfDelta(uint gid) {
    if (gid >= uint(uFluidCount)) return;
    uint id = fluidId(gid);
    ParticleState current = particle[id];
    float h = uVoxelSize;
    float spacing = uVoxelSize * 0.5;
    float restDensity = 1000.0;
    float particleMass = restDensity * spacing * spacing * spacing;
    float h2 = h * h, h6 = h2 * h2 * h2, h9 = h6 * h2 * h;
    float poly6Coeff = 315.0 / (64.0 * 3.14159265358979323846 * h9);
    float spikyCoeff = -45.0 / (3.14159265358979323846 * h6);
    float volume = particleMass / restDensity;
    float scorrK = 0.2;
    float scorrDeltaQ = h * 0.2;
    float referenceKernel = pbfPoly6(scorrDeltaQ * scorrDeltaQ, h, poly6Coeff);

    vec3 delta = vec3(0.0);
    uint cachedCount = fluidNeighbors[gid].count;
    if (cachedCount <= PBF_MAX_NEIGHBORS) {
        for (uint k = 0u; k < cachedCount; ++k) {
            uint neighbor = fluidNeighbors[gid].neighbors[k];
            if (neighbor == id) continue;
            vec3 sep = current.predicted_base_inv_mass.xyz - particle[neighbor].predicted_base_inv_mass.xyz;
            float wVal = pbfPoly6(dot(sep, sep), h, poly6Coeff);
            if (wVal <= 0.0) continue;
            float ratio = (referenceKernel > 0.0) ? wVal / referenceKernel : 0.0;
            float ratioSq = ratio * ratio;
            float scorr = -scorrK * (0.25 * uVoxelSize * uVoxelSize) * (ratioSq * ratioSq);
            float scale = volume * (fluid[id].density_lambda.y + fluid[neighbor].density_lambda.y + scorr);
            delta += scale * pbfSpikyGradient(sep, h, spikyCoeff);
        }
    } else {
        ivec3 currentCell = cell[id].xyz;
        for (int dz = -1; dz <= 1; ++dz) for (int dy = -1; dy <= 1; ++dy) for (int dx = -1; dx <= 1; ++dx) {
            ivec3 neighborCell = currentCell + ivec3(dx, dy, dz);
            int item = hashHead[hashCoord(neighborCell, uHashSize)];
            int traversed = 0;
            while (item >= 0 && traversed < int(dispatchArgs[8])) {
                ++traversed;
                uint neighbor = simId[uint(gpuControl.z) + uint(item)];
                if (neighbor != id && isFluid(particle[neighbor]) && all(equal(cell[neighbor].xyz, neighborCell))) {
                    vec3 sep = current.predicted_base_inv_mass.xyz - particle[neighbor].predicted_base_inv_mass.xyz;
                    float wVal = pbfPoly6(dot(sep, sep), h, poly6Coeff);
                    if (wVal > 0.0) {
                        float ratio = (referenceKernel > 0.0) ? wVal / referenceKernel : 0.0;
                        float ratioSq = ratio * ratio;
                        float scorr = -scorrK * (0.25 * uVoxelSize * uVoxelSize) * (ratioSq * ratioSq);
                        float scale = volume * (fluid[id].density_lambda.y + fluid[neighbor].density_lambda.y + scorr);
                        delta += scale * pbfSpikyGradient(sep, h, spikyCoeff);
                    }
                }
                item = hashNext[item];
            }
        }
    }
    float deltaLength = length(delta);
    float deltaLimit = 0.0125 * uVoxelSize;
    if (deltaLength > deltaLimit) delta *= deltaLimit / deltaLength;
    fluid[id].delta = vec4(0.0);
    particle[id].predicted_base_inv_mass.xyz += delta;
    staticCollisionParticleDirect(id);
}

void pbfApply(uint gid) {
    if (gid >= uint(uFluidCount)) return;
    uint id = fluidId(gid);
    particle[id].predicted_base_inv_mass.xyz += fluid[id].delta.xyz;
    fluid[id].delta = vec4(0.0);
}

void pbfStaticCollisions(uint gid) {
    if (gid >= uint(uFluidCount)) return;
    uint id = fluidId(gid);
    staticCollisionParticleDirect(id);
}

void pbfApplyAndStaticCollisions(uint gid) {
    pbfApply(gid);
    pbfStaticCollisions(gid);
}

void pbfDynamicSolidCollisions(uint gid, bool react) {
    if (gid >= uint(uFluidCount)) return;
    uint id = fluidId(gid);
    float radius = particle[id].pos_radius.w;
    vec3 position = particle[id].predicted_base_inv_mass.xyz;
    vec3 previous = particle[id].prev_inv_mass.xyz;
    const ivec4 faceCorner[6] = ivec4[6](
        ivec4(0, 2, 6, 4), ivec4(1, 5, 7, 3),
        ivec4(0, 4, 5, 1), ivec4(2, 3, 7, 6),
        ivec4(0, 1, 3, 2), ivec4(4, 6, 7, 5)
    );

    for (int voxelId = 0; voxelId < uVoxelCount; ++voxelId) {
        VoxelState solid = voxel[voxelId];
        if (solid.flags.y != 0 || solid.flags.z != 0) continue;

        float maxReach = uVoxelSize * 1.5 + radius;
        vec3 toPos = abs(position - solid.pos_rest_edge.xyz);
        vec3 toPrev = abs(previous - solid.pos_rest_edge.xyz);
        if ((toPos.x > maxReach && toPrev.x > maxReach) ||
            (toPos.z > maxReach && toPrev.z > maxReach) ||
            (toPos.y > maxReach + uVoxelSize && toPrev.y > maxReach + uVoxelSize)) {
            continue;
        }

        vec3 corner[8];
        vec3 boundsMin = vec3(1e30);
        vec3 boundsMax = vec3(-1e30);
        bool valid = true;
        for (int i = 0; i < 8; ++i) {
            uint cornerId = voxelParticle(solid, i);
            if (cornerId >= uint(gpuControl.x)) { valid = false; break; }
            corner[i] = particle[cornerId].predicted_base_inv_mass.xyz;
            boundsMin = min(boundsMin, corner[i]);
            boundsMax = max(boundsMax, corner[i]);
        }
        if (!valid) continue;
        vec3 expandedMin = boundsMin - vec3(radius);
        vec3 expandedMax = boundsMax + vec3(radius);
        uint glueMask = solid.lifecycle.z;
        bool recoverBelow = (glueMask & (1u << 2)) == 0u &&
                            position.x >= expandedMin.x && position.x <= expandedMax.x &&
                            position.z >= expandedMin.z && position.z <= expandedMax.z &&
                            position.y < expandedMin.y &&
                            position.y >= expandedMin.y - max(2.0 * radius, uVoxelSize);
        if (!recoverBelow && (
            (position.x < boundsMin.x - radius && previous.x < boundsMin.x - radius) ||
            (position.y < boundsMin.y - radius && previous.y < boundsMin.y - radius) ||
            (position.z < boundsMin.z - radius && previous.z < boundsMin.z - radius) ||
            (position.x > boundsMax.x + radius && previous.x > boundsMax.x + radius) ||
            (position.y > boundsMax.y + radius && previous.y > boundsMax.y + radius) ||
            (position.z > boundsMax.z + radius && previous.z > boundsMax.z + radius))) continue;

        bool currentInside = all(greaterThanEqual(position, expandedMin)) && all(lessThanEqual(position, expandedMax));
        bool previousInside = all(greaterThanEqual(previous, expandedMin)) && all(lessThanEqual(previous, expandedMax));
        int nearestFace = -1;
        float entryT = 0.0;
        float exitT = 1.0;
        vec3 movement = position - previous;
        bool segmentHits = true;
        for (int axis = 0; axis < 3; ++axis) {
            float origin = previous[axis];
            float direction = movement[axis];
            if (abs(direction) <= 1e-8) {
                if (origin < expandedMin[axis] || origin > expandedMax[axis]) {
                    segmentHits = false;
                    break;
                }
                continue;
            }
            float tMin = (expandedMin[axis] - origin) / direction;
            float tMax = (expandedMax[axis] - origin) / direction;
            int minFace = axis * 2;
            int maxFace = minFace + 1;
            if (tMin > tMax) {
                float swapT = tMin; tMin = tMax; tMax = swapT;
                int swapFace = minFace; minFace = maxFace; maxFace = swapFace;
            }
            if (tMin > entryT) {
                entryT = tMin;
                nearestFace = minFace;
            }
            exitT = min(exitT, tMax);
            if (entryT > exitT) {
                segmentHits = false;
                break;
            }
        }
        if (!recoverBelow && !currentInside &&
            (!segmentHits || previousInside || entryT < 0.0 || entryT > 1.0)) {
            continue;
        }
        if (recoverBelow) {
            nearestFace = 3;
        } else if (nearestFace < 0 || previousInside) {
            vec3 sideSample = previousInside ? previous : position;
            float distances[6] = float[6](
                abs(sideSample.x - expandedMin.x), abs(expandedMax.x - sideSample.x),
                abs(sideSample.y - expandedMin.y), abs(expandedMax.y - sideSample.y),
                abs(sideSample.z - expandedMin.z), abs(expandedMax.z - sideSample.z)
            );
            float nearest = 1e30;
            for (int face = 0; face < 6; ++face) {
                if ((glueMask & (1u << uint(face))) != 0u) continue;
                if (face == 2 && (previous.y >= (expandedMin.y + expandedMax.y) * 0.5 || movement.y <= 0.0)) {
                    continue;
                }
                if (face == 3 && (previous.y < (expandedMin.y + expandedMax.y) * 0.5 && movement.y > 0.0)) {
                    continue;
                }
                if (distances[face] < nearest) {
                    nearest = distances[face];
                    nearestFace = face;
                }
            }
            if (nearestFace < 0) {
                nearestFace = (movement.y <= 0.0 && (glueMask & (1u << 3)) == 0u) ? 3 : 2;
            }
        }
        if (nearestFace < 0) continue;

        vec3 correctionDelta = vec3(0.0);
        if (nearestFace == 0) correctionDelta.x = expandedMin.x - position.x - 1e-4;
        else if (nearestFace == 1) correctionDelta.x = expandedMax.x - position.x + 1e-4;
        else if (nearestFace == 2) correctionDelta.y = expandedMin.y - position.y - 1e-4;
        else if (nearestFace == 3) correctionDelta.y = expandedMax.y - position.y + 1e-4;
        else if (nearestFace == 4) correctionDelta.z = expandedMin.z - position.z - 1e-4;
        else correctionDelta.z = expandedMax.z - position.z + 1e-4;

        position += correctionDelta;
        if (nearestFace <= 1) previous.x = position.x;
        else if (nearestFace <= 3) previous.y = position.y;
        else previous.z = position.z;

        if (react) {
            ivec4 fc = faceCorner[nearestFace];
            vec3 cornerReaction = -correctionDelta * (0.02 * 0.25);
            float maxReaction = 0.05 * uVoxelSize;
            cornerReaction = clamp(cornerReaction, vec3(-maxReaction), vec3(maxReaction));
            for (int i = 0; i < 4; ++i) {
                uint cornerId = voxelParticle(solid, fc[i]);
                if (cornerId < uint(gpuControl.x) && particle[cornerId].prev_inv_mass.w > 0.0) {
                    accumulate(cornerId, cornerReaction, 1.0);
                }
            }
        }
    }
    particle[id].predicted_base_inv_mass.xyz = position;
    particle[id].prev_inv_mass.xyz = previous;
}

void pbfViscosity(uint gid) {
    if (gid >= uint(uFluidCount)) return;
    uint id = fluidId(gid);
    ParticleState current = particle[id];
    float h = uVoxelSize;
    float spacing = uVoxelSize * 0.5;
    float restDensity = 1000.0;
    float particleMass = restDensity * spacing * spacing * spacing;
    float h2 = h * h, h6 = h2 * h2 * h2, h9 = h6 * h2 * h;
    float poly6Coeff = 315.0 / (64.0 * 3.14159265358979323846 * h9);
    float viscosity = 0.15;

    vec3 velocityDelta = vec3(0.0);
    uint cachedCount = fluidNeighbors[gid].count;
    if (cachedCount <= PBF_MAX_NEIGHBORS) {
        for (uint k = 0u; k < cachedCount; ++k) {
            uint neighbor = fluidNeighbors[gid].neighbors[k];
            if (neighbor == id) continue;
            vec3 sep = current.pos_radius.xyz - particle[neighbor].pos_radius.xyz;
            float wVal = pbfPoly6(dot(sep, sep), h, poly6Coeff);
            float neighborDensity = max(fluid[neighbor].density_lambda.x, restDensity * 0.1);
            float scale = viscosity * particleMass * wVal / neighborDensity;
            velocityDelta += (particle[neighbor].velocity.xyz - current.velocity.xyz) * scale;
        }
    } else {
        ivec3 currentCell = cell[id].xyz;
        for (int dz = -1; dz <= 1; ++dz) for (int dy = -1; dy <= 1; ++dy) for (int dx = -1; dx <= 1; ++dx) {
            ivec3 neighborCell = currentCell + ivec3(dx, dy, dz);
            int item = hashHead[hashCoord(neighborCell, uHashSize)];
            int traversed = 0;
            while (item >= 0 && traversed < int(dispatchArgs[8])) {
                ++traversed;
                uint neighbor = simId[uint(gpuControl.z) + uint(item)];
                if (neighbor != id && isFluid(particle[neighbor]) && all(equal(cell[neighbor].xyz, neighborCell))) {
                    vec3 sep = current.pos_radius.xyz - particle[neighbor].pos_radius.xyz;
                    float wVal = pbfPoly6(dot(sep, sep), h, poly6Coeff);
                    float neighborDensity = max(fluid[neighbor].density_lambda.x, restDensity * 0.1);
                    float scale = viscosity * particleMass * wVal / neighborDensity;
                    velocityDelta += (particle[neighbor].velocity.xyz - current.velocity.xyz) * scale;
                }
                item = hashNext[item];
            }
        }
    }
    fluid[id].delta = vec4(velocityDelta, 0.0);
}

void pbfApplyViscosity(uint gid) {
    if (gid >= uint(uFluidCount)) return;
    uint id = fluidId(gid);
    particle[id].velocity.xyz += fluid[id].delta.xyz;
    fluid[id].delta = vec4(0.0);
}

void main() {
    uint gid=gl_GlobalInvocationID.x;
    if (uParticleCount < 0 || uSimCount < 0) return;
    if (uMode==MODE_RESET) resetCorrections(gid);
    else if (uMode==MODE_INTEGRATE) integrateParticle(gid);
    else if (uMode==MODE_HASH_CLEAR) clearHash(gid);
    else if (uMode==MODE_HASH_BUILD) buildHash(gid);
    else if (uMode==MODE_PAIR_COLLISIONS) pairCollisions(gid);
    else if (uMode==MODE_APPLY) applyCorrections(gid);
    else if (uMode==MODE_VGS) solveVgs(gid);
    else if (uMode==MODE_STATIC_COLLISIONS) staticCollisions(gid);
    else if (uMode==MODE_BREAK_MASK) gatherBreakMask(gid);
    else if (uMode==MODE_FINALIZE_PARTICLES) finalizeParticle(gid);
    else if (uMode==MODE_FINALIZE_VOXELS) finalizeVoxel(gid);
    else if (uMode==MODE_SPLIT_BREAKS) splitBrokenFaces(gid);
    else if (uMode==MODE_PREPARE_INDIRECT) prepareIndirect(gid);
    else if (uMode==MODE_WAKE_GATHER) wakeGather(gid);
    else if (uMode==MODE_WAKE_APPLY) wakeApply(gid);
    else if (uMode==MODE_TOPOLOGY_REBUILD_SERIAL) topologyRebuildSerial(gid);
    else if (uMode==MODE_PBF_BUILD_NEIGHBORS) pbfBuildNeighbors(gid);
    else if (uMode==MODE_PBF_LAMBDA) pbfLambda(gid);
    else if (uMode==MODE_PBF_DELTA) pbfDelta(gid);
    else if (uMode==MODE_PBF_APPLY) pbfApplyAndStaticCollisions(gid);
    else if (uMode==MODE_PBF_STATIC_COLLISIONS) pbfStaticCollisions(gid);
    else if (uMode==MODE_PBF_DYNAMIC_SOLID_COLLISIONS) pbfDynamicSolidCollisions(gid, true);
    else if (uMode==MODE_PBF_DYNAMIC_SOLID_FINAL) pbfDynamicSolidCollisions(gid, false);
    else if (uMode==MODE_PBF_VISCOSITY) pbfViscosity(gid);
    else if (uMode==MODE_PBF_APPLY_VISCOSITY) pbfApplyViscosity(gid);
}
