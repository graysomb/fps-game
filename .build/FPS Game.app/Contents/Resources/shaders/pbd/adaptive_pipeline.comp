#version 430
layout(local_size_x=128) in;
#include "adaptive_types.inc"
layout(std430,binding=0) readonly buffer Cells { AdCell cells[]; };
layout(std430,binding=1) writeonly buffer OutputCells { AdCell outputCells[]; };
layout(std430,binding=2) readonly buffer Links { AdLink links[]; };
layout(std430,binding=3) readonly buffer Ranges { AdRange ranges[]; };
layout(std430,binding=4) readonly buffer Ids { int ids[]; };
layout(std430,binding=5) readonly buffer Contacts { AdContact contacts[]; };
layout(std430,binding=6) readonly buffer ContactRanges { AdRange cr[]; };
layout(std430,binding=7) readonly buffer ContactIds { int ci[]; };
uniform int cellCount,mode;
uniform float unit;
#define AD_FN
#define AD_MAX(a,b) max(float(a),float(b))
#define AD_CELL(i) cells[i]
#define AD_RANGE(i) ranges[i]
#define AD_LINK(i) links[i]
#define AD_ID(i) ids[i]
#define AD_CRANGE(i) cr[i]
#define AD_CONTACT(i) contacts[i]
#define AD_CID(i) ci[i]
#define AD_LINK_PARAMS int unused
#define AD_CONTACT_PARAMS int unused
#include "adaptive_kernel.inc"
void main() {
    int index=int(gl_GlobalInvocationID.x);
    if(index>=cellCount)return;
    if(mode==0)outputCells[index]=ad_shape_cell(cells[index],unit);
    else if(mode==1)outputCells[index]=ad_solve_links(index,0);
    else outputCells[index]=ad_solve_contacts(index,0);
}
