    Particle **samples; int sample_count;
    Particle ***sources; float **weights; int *source_count;
    int *pool_to_sample;
    unsigned char *parent_use,*promoted;
    int *owner;
    int *dependent_order,dependent_count,*attachment_order,attachment_count;
    Particle **collision_samples;int collision_count;
    int child_begin,child_count,independent_count;
    double cover_ms;
} GreedyCoarseSystem;
static GreedyCoarseSystem greedyCoarse;
