static bool greedy_flatten_sample(int sample,unsigned char *state){GreedyCoarseSystem *g=&greedyCoarse;if(sample<0||sample>=g->sample_count)return false;if(g->source_count[sample]<=1||g->promoted[sample])return true;if(state[sample]==2)return true;if(state[sample]==1)return false;state[sample]=1;
