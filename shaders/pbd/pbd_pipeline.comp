int gatherSphereContacts(vec3 aPosition[9],float aRadius[9],vec3 bPosition[9],
                         float bRadius[9],out SphereContact contacts[4]){
    int count=0;vec3 fallback=aPosition[8]-bPosition[8];float fs=dot(fallback,fallback);
    fallback=fs>1e-12?fallback*inversesqrt(fs):vec3(1,0,0);
    for(int a=0;a<9;++a)for(int b=0;b<9;++b){float target=aRadius[a]+bRadius[b];
        vec3 delta=aPosition[a]-bPosition[b];float ds=dot(delta,delta);
        if(ds>=target*target)continue;float distance=sqrt(max(ds,0.0));SphereContact contact;
        contact.aProxy=uint(a);contact.bProxy=uint(b);contact.depth=target-distance;
        contact.normal=distance>1e-6?delta/distance:fallback;insertSphereContact(contacts,count,contact);}
    return count;
