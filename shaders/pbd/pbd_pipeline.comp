float sphereProxyWeight(uint proxy,int corner){
    return proxy==8u?0.125:(proxy==uint(corner)?1.0:0.0);
}

uint amrEmbeddedRelation(uint id){
    if(id>=amrControl.padding[1])return 0xffffffffu;
    uint offsets=amrControl.hierarchy_count*PARTIAL_NODE_WORDS+
                 amrControl.padding[0]*PARTIAL_REL_WORDS;
    uint incidences=offsets+amrControl.padding[1]+1u;
    for(uint i=partial[offsets+id];i<partial[offsets+id+1u];++i){
        uint rel=partial[incidences+i],record=partialRelationBase(rel);
        uint stage=uint(uVoxelCount)+partial[record+1u];
        if(stage>=amrControl.total_stage_count)continue;
        VoxelState owner=voxel[stage];
        if(owner.flags.w!=0&&owner.flags.x!=0&&amrPartial(owner)&&
           !amrHasActiveChildren(owner))return rel;
    }
    return 0xffffffffu;
}

void sphereContactDof(uint id,float proxyWeight,float sign,vec3 normal,
                      float lambda,bool scatter,inout float denominator){
    if(id>=uint(gpuControl.x)||proxyWeight<=0.0)return;
    float inv=particle[id].prev_inv_mass.w;
    if(inv>0.0){if(scatter)accumulate(id,normal*(sign*lambda*inv*proxyWeight),1.0);
        else denominator+=inv*proxyWeight*proxyWeight;return;}
    uint rel=amrEmbeddedRelation(id);if(rel==0xffffffffu)return;
    uint record=partialRelationBase(rel),stage=uint(uVoxelCount)+partial[record+1u];
    uint base=partialNodeBase(stage),rank=partial[base+2u];
    for(uint a=0u;a<rank;++a){uint anchor=voxelParticle(voxel[stage],int(a));
        if(anchor>=uint(gpuControl.x))continue;
        float w=proxyWeight*partialFloat(record+4u+a);
        float mass=particle[anchor].prev_inv_mass.w;if(mass<=0.0)continue;
        if(scatter)accumulate(anchor,normal*(sign*lambda*mass*w),1.0);
        else denominator+=mass*w*w;
    }
}

void scatterSphereContact(uint aId,uint bId,bool dynamicB,SphereContact contact){
    VoxelState a=voxel[aId];VoxelState b;if(dynamicB)b=voxel[bId];float denominator=0.0;
    for(int c=0;c<8;++c){float weight=sphereProxyWeight(contact.aProxy,c);
        uint id=voxelParticle(a,c);sphereContactDof(id,weight,1.0,contact.normal,
            0.0,false,denominator);
        if(dynamicB){weight=sphereProxyWeight(contact.bProxy,c);id=voxelParticle(b,c);
            sphereContactDof(id,weight,-1.0,contact.normal,0.0,false,denominator);}}
    if(denominator<=uVgsEpsilon)return;float lambda=uCollisionRelaxation*contact.depth/denominator;
    for(int c=0;c<8;++c){float weight=sphereProxyWeight(contact.aProxy,c);uint id=voxelParticle(a,c);
        sphereContactDof(id,weight,1.0,contact.normal,lambda,true,denominator);
        if(dynamicB){weight=sphereProxyWeight(contact.bProxy,c);id=voxelParticle(b,c);
            sphereContactDof(id,weight,-1.0,contact.normal,lambda,true,denominator);}}
}

bool amrSphereTerminal(uint gid,VoxelState v){
    bool hierarchyNode=gid>=uint(uVoxelCount);uint parent=hierarchyNode?
        floatBitsToUint(v.pos_rest_edge.x):floatBitsToUint(amrState[gid].latest[7]);
    bool owned=hierarchyNode||parent<amrControl.total_stage_count;
    if(!owned||v.flags.x==0||v.flags.y!=0||v.flags.z!=0||
       amrOccupancy(v)!=2u||amrRealMask(v)!=0xffu)return false;
    if(hierarchyNode)return v.flags.w!=0&&!amrHasActiveChildren(v);
    return v.flags.w!=0||amrEmbeddedRelation(voxelParticle(v,0))!=0xffffffffu;
}

int sphereShapeBody(VoxelState v){uint id=voxelParticle(v,0);
    return id<uint(gpuControl.x)?collisionMeta[id].w:-1;}

void aabbClear(uint gid){
    if(aabbControl.mode==3u){
        if(gid<uint(max(gpuControl.y,0))){
            uint id=simId[gid];if(id<amrControl.particle_capacity)aabbOwner[id]=0u;
        }
    }else{
        if(gid<amrControl.particle_capacity)aabbOwner[gid]=0u;
        if(gid<aabbControl.total_stage_count)aabbState[gid].meta.x=0u;
    }
    if(gid==0u){aabbControl.proxy_count=0u;aabbControl.candidate_count=0u;
        aabbControl.contact_count=0u;aabbControl.overflow=0u;aabbControl.node_visit_count=0u;
        aabbControl.bounds_reject_count=0u;aabbControl.empty_reject_count=0u;
        aabbControl.max_stack_depth=0u;}
}

void atomicMaxAabbStack(uint candidate){atomicMax(aabbControl.max_stack_depth,candidate);}

void amrSphereSetup(uint gid){
    uint activeBase=16u+4u*amrControl.constraint_capacity;
    if(aabbControl.mode==0u||gid>=dispatchArgs[activeBase])return;
    gid=dispatchArgs[activeBase+4u+gid];VoxelState v=voxel[gid];
    bool hierarchyNode=gid>=uint(uVoxelCount);uint parent=hierarchyNode?
        floatBitsToUint(v.pos_rest_edge.x):floatBitsToUint(amrState[gid].latest[7]);
    bool owned=hierarchyNode||parent<amrControl.total_stage_count;if(owned)for(int c=0;c<8;++c){
        uint id=voxelParticle(v,c);if(id<amrControl.particle_capacity)aabbOwner[id]=1u;}
    if(gid<uint(uVoxelCount)){bool externalShape=parent>=amrControl.total_stage_count&&v.flags.x!=0&&
        v.flags.w!=0&&v.flags.y==0&&v.flags.z==0;if(externalShape)atomicAdd(aabbControl.proxy_count,1u);}
}

void amrSphereTreeCollisions(uint gid){
    uint activeBase=16u+4u*amrControl.constraint_capacity;
    if(aabbControl.mode==0u||gid>=dispatchArgs[activeBase])return;
    gid=dispatchArgs[activeBase+4u+gid];
    VoxelState queryVoxel=voxel[gid];bool hierarchyQuery=gid>=uint(uVoxelCount);
    uint parent=hierarchyQuery?floatBitsToUint(queryVoxel.pos_rest_edge.x):
        floatBitsToUint(amrState[gid].latest[7]);
    bool externalQuery=!hierarchyQuery&&parent>=amrControl.total_stage_count&&
        queryVoxel.flags.x!=0&&queryVoxel.flags.w!=0&&queryVoxel.flags.y==0&&queryVoxel.flags.z==0;
    if(!externalQuery&&!amrSphereTerminal(gid,queryVoxel))return;
    vec3 queryPosition[9];uint queryParticle[8];if(!loadSphereShape(gid,queryPosition,queryParticle))return;
    float queryProxyRadius[9];loadSphereRadii(queryVoxel.pos_rest_edge.w,queryParticle,queryProxyRadius);
    int queryBody=sphereShapeBody(queryVoxel);float queryRadius=0.5*queryVoxel.pos_rest_edge.w;
    uint queryRoot=floatBitsToUint(amrState[gid].previous[6]);uint root=uint(uVoxelCount);
    while(root<amrControl.total_stage_count){uint nextRoot=voxel[root].lifecycle.x;
      if(root!=queryRoot&&(queryRoot>=amrControl.total_stage_count||queryRoot<root)&&voxel[root].flags.w!=0){
        uint stack[64];uint stackSize=1u;stack[0]=root;atomicMaxAabbStack(stackSize);
