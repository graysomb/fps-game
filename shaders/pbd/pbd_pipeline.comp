          atomicAdd(aabbControl.node_visit_count,1u);VoxelState node=voxel[nodeId];
          uint occupancy=amrOccupancy(node);if(occupancy==0u){atomicAdd(aabbControl.empty_reject_count,1u);continue;}
          vec3 nodePosition[9];uint nodeParticle[8];if(occupancy==2u){
            if(amrRealMask(node)!=0xffu||!loadSphereShape(nodeId,nodePosition,nodeParticle)||
               !sphereHexOverlap(queryPosition,queryRadius,nodePosition,0.5*node.pos_rest_edge.w)){
                atomicAdd(aabbControl.bounds_reject_count,1u);continue;}}
          bool hierarchyNode=nodeId>=uint(uVoxelCount);bool descend=occupancy==1u||
              (hierarchyNode&&amrHasActiveChildren(node));
          if(descend&&hierarchyNode){for(int c=7;c>=0;--c){uint child=amrChild(node,c);
              if(child>=amrControl.total_stage_count){atomicAdd(aabbControl.empty_reject_count,1u);continue;}
              if(occupancy!=1u&&voxel[child].flags.w==0)continue;if(stackSize>=64u){
                  atomicExchange(aabbControl.overflow,1u);return;}stack[stackSize++]=child;}
              atomicMaxAabbStack(stackSize);continue;}
          if(occupancy!=2u||!amrSphereTerminal(nodeId,node)||
             sphereShapeBody(node)==queryBody)continue;
          atomicAdd(aabbControl.candidate_count,1u);float nodeProxyRadius[9];
          loadSphereRadii(node.pos_rest_edge.w,nodeParticle,nodeProxyRadius);SphereContact contacts[4];
          int contactCount=gatherSphereContacts(queryPosition,queryProxyRadius,nodePosition,nodeProxyRadius,contacts);
          for(int c=0;c<contactCount;++c)scatterSphereContact(gid,nodeId,true,contacts[c]);
          if(contactCount>0)atomicAdd(aabbControl.contact_count,uint(contactCount));
        }}root=nextRoot;
    }
}

void gatherSpherePlaneContact(int proxy,float depth,vec3 normal,
                              inout SphereContact contacts[4],inout int count){
    if(depth<=0.0)return;SphereContact contact;contact.aProxy=uint(proxy);contact.bProxy=0u;
    contact.depth=depth;contact.normal=normal;insertSphereContact(contacts,count,contact);
}

void amrSphereStaticCollisions(uint gid){
    uint activeBase=16u+4u*amrControl.constraint_capacity;
    if(aabbControl.mode==0u||gid>=dispatchArgs[activeBase])return;
    gid=dispatchArgs[activeBase+4u+gid];VoxelState v=voxel[gid];
    if(!amrSphereTerminal(gid,v))return;vec3 position[9];uint particleId[8];
    if(!loadSphereShape(gid,position,particleId))return;float proxyRadius[9];
    loadSphereRadii(v.pos_rest_edge.w,particleId,proxyRadius);SphereContact contacts[4];int contactCount=0;
    for(int p=0;p<9;++p){float radius=proxyRadius[p];
        gatherSpherePlaneContact(p,radius-position[p].y,vec3(0,1,0),contacts,contactCount);
        gatherSpherePlaneContact(p,-uFloorSize+radius-position[p].x,vec3(1,0,0),contacts,contactCount);
        gatherSpherePlaneContact(p,position[p].x+radius-uFloorSize,vec3(-1,0,0),contacts,contactCount);
        gatherSpherePlaneContact(p,-uFloorSize+radius-position[p].z,vec3(0,0,1),contacts,contactCount);
        gatherSpherePlaneContact(p,position[p].z+radius-uFloorSize,vec3(0,0,-1),contacts,contactCount);}
    for(int c=0;c<contactCount;++c)scatterSphereContact(gid,0u,false,contacts[c]);
    if(contactCount>0)atomicAdd(aabbControl.contact_count,uint(contactCount));
    if(uStaticColliderCount<=0)return;vec3 boundsMin=vec3(3.402823e38),boundsMax=vec3(-3.402823e38);
    for(int p=0;p<9;++p){boundsMin=min(boundsMin,position[p]-vec3(proxyRadius[p]));
        boundsMax=max(boundsMax,position[p]+vec3(proxyRadius[p]));}
    ivec3 cellMin=ivec3(floor(boundsMin/uVoxelSize)),cellMax=ivec3(floor(boundsMax/uVoxelSize));
    ivec3 cellSpan=cellMax-cellMin+1;if(any(lessThanEqual(cellSpan,ivec3(0)))||
        any(greaterThan(cellSpan,ivec3(64)))){atomicExchange(aabbControl.overflow,1u);return;}
    bool surfaceMode=dispatchArgs[12]!=0u;int seen[128];int seenCount=0;
    for(int z=cellMin.z;z<=cellMax.z;++z)for(int y=cellMin.y;y<=cellMax.y;++y)
    for(int x=cellMin.x;x<=cellMax.x;++x){int item=findStaticCell(ivec3(x,y,z));int guard=0;
      while(item!=-1&&guard++<uStaticColliderCount+1){int sid=item;if(!surfaceMode&&item<=-2)sid=-item-2;
        if(sid<0||sid>=uStaticColliderCount)break;StaticCollider box=staticCollider[sid];
        int patchId=surfaceMode?floatBitsToInt(box.bounds_min.w):sid;bool duplicate=false;
        for(int s=0;s<seenCount;++s)duplicate=duplicate||seen[s]==patchId;if(!duplicate){
          if(seenCount<128)seen[seenCount++]=patchId;vec3 boxMin=box.bounds_min.xyz,boxMax=box.bounds_max.xyz;
          float skin=max(1e-4,0.002*uVoxelSize);for(int d=0;d<3;++d)if(boxMax[d]-boxMin[d]<2.0*skin){
            float middle=0.5*(boxMin[d]+boxMax[d]);boxMin[d]=middle-skin;boxMax[d]=middle+skin;}
          contactCount=0;for(int p=0;p<9;++p){float radius=proxyRadius[p];vec3 nearest=clamp(position[p],boxMin,boxMax);
            vec3 delta=position[p]-nearest;float ds=dot(delta,delta);if(ds>=radius*radius)continue;
            float distance=sqrt(max(ds,0.0));SphereContact contact;contact.aProxy=uint(p);contact.bProxy=0u;
            if(distance>1e-6){contact.normal=delta/distance;contact.depth=radius-distance;}
            else{float distanceToFace[6]=float[6](position[p].x-boxMin.x,boxMax.x-position[p].x,
                position[p].y-boxMin.y,boxMax.y-position[p].y,position[p].z-boxMin.z,boxMax.z-position[p].z);
                int face=0;for(int f=1;f<6;++f)if(distanceToFace[f]<distanceToFace[face])face=f;
                vec3 normals[6]=vec3[6](vec3(-1,0,0),vec3(1,0,0),vec3(0,-1,0),
                    vec3(0,1,0),vec3(0,0,-1),vec3(0,0,1));contact.normal=normals[face];
                contact.depth=radius+distanceToFace[face];}insertSphereContact(contacts,contactCount,contact);}
          for(int c=0;c<contactCount;++c)scatterSphereContact(gid,0u,false,contacts[c]);
          if(contactCount>0)atomicAdd(aabbControl.contact_count,uint(contactCount));}
        if(!surfaceMode||item<=-2)break;item=floatBitsToInt(box.center.w);}
      if(guard>=uStaticColliderCount+1&&item!=-1)atomicExchange(aabbControl.overflow,1u);}
}

void main() {
    uint gid=gl_GlobalInvocationID.x;
    if (uParticleCount < 0 || uSimCount < 0) return;
    if (uMode==MODE_RESET) resetCorrections(gid);
    else if (uMode==MODE_INTEGRATE) integrateParticle(gid);
    else if (uMode==MODE_HASH_CLEAR) clearHash(gid);
    else if (uMode==MODE_HASH_BUILD) buildHash(gid);
    else if (uMode==MODE_PAIR_COLLISIONS) pairCollisions(gid);
    else if (uMode==MODE_APPLY) applyCorrections(gid);
    else if (uMode==MODE_VGS) {
        if (gid < uint(uVgsCount) && gid < amrControl.constraint_count) {
            uint base = 16u + gid * 4u;
            uint kind = dispatchArgs[base], voxelId = dispatchArgs[base + 1u];
            if (kind == 0u) solveVgs(voxelId);
            else if(kind==3u)scatterPartialWeld(voxelId,dispatchArgs[base+2u]);
            else scatterHierarchyWeld(voxelId, dispatchArgs[base + 2u], kind == 2u);
        }
    }
    else if (uMode==MODE_STATIC_COLLISIONS) staticCollisions(gid);
    else if (uMode==MODE_BREAK_MASK || uMode==MODE_AMR_BREAK_MASK) gatherBreakMask(gid);
    else if (uMode==MODE_FINALIZE_PARTICLES) finalizeParticle(gid);
    else if (uMode==MODE_FINALIZE_VOXELS) finalizeVoxel(gid);
    else if (uMode==MODE_SPLIT_BREAKS) splitBrokenFaces(gid);
    else if (uMode==MODE_PREPARE_INDIRECT) prepareIndirect(gid);
    else if (uMode==MODE_WAKE_GATHER) wakeGather(gid);
    else if (uMode==MODE_WAKE_APPLY) wakeApply(gid);
    else if (uMode==MODE_TOPOLOGY_REBUILD_SERIAL) topologyRebuildSerial(gid);
    else if (uMode==MODE_HIERARCHY_MASK) propagateHierarchyMask(gid);
    else if (uMode==MODE_AMR_CLEAR) amrClear(gid);
    else if (uMode==MODE_AMR_SAMPLE) amrSample(gid);
    else if (uMode==MODE_AMR_SAMPLE_COMPLETE) { if(gid==0u){ amrControl.sample_count++; amrControl.changed=0u; } }
    else if (uMode==MODE_AMR_SELECT) amrSelect(gid);
    else if (uMode==MODE_AMR_RESOLVE) amrResolve(gid);
    else if (uMode==MODE_AMR_TRANSITION_CLEAR) amrScratchClear(gid);
    else if (uMode==MODE_AMR_TRANSITION_SCATTER) amrTransitionScatter(gid);
    else if (uMode==MODE_AMR_TRANSITION_APPLY) amrTransitionApply(gid);
    else if (uMode==MODE_AMR_TOPOLOGY_APPLY) amrTopologyApply(gid);
    else if (uMode==MODE_AMR_ACTIVE_CLEAR && gid==0u)
        dispatchArgs[16u+4u*amrControl.constraint_capacity]=0u;
    else if (uMode==MODE_AMR_PREPARE_TRANSITION && gid==0u){
        uint base=16u+4u*amrControl.constraint_capacity+4u+amrControl.total_stage_count;
        dispatchArgs[base]=amrControl.changed!=0u?(amrControl.particle_capacity+127u)/128u:0u;
        dispatchArgs[base+1u]=1u;dispatchArgs[base+2u]=1u;
    }
    else if (uMode==MODE_AMR_MASS_SCATTER) amrMassScatter(gid);
    else if (uMode==MODE_AMR_COMPACT) amrCompact(gid);
    else if (uMode==MODE_AMR_COMPILE) amrCompile(gid);
    else if (uMode==MODE_AMR_PREPARE_INDIRECT) amrPrepareIndirect(gid);
    else if (uMode==MODE_AMR_DORMANT_SCATTER) amrDormantScatter(gid);
    else if (uMode==MODE_AMR_DORMANT_FULL_SNAPSHOT) {
        if (gid<uint(uVgsCount)) {
            uint stage=uint(uVgsBegin)+gid;
            if(stage<amrControl.total_stage_count&&!amrPartial(voxel[stage]))
                amrFullDormantScatter(gid);
        }
    }
    else if (uMode==MODE_AABB_CLEAR) aabbClear(gid);
    else if (uMode==MODE_AABB_BOUNDS) amrSphereSetup(gid);
    else if (uMode==MODE_AABB_HASH_BUILD) { }
    else if (uMode==MODE_AABB_COLLISIONS) amrSphereTreeCollisions(gid);
    else if (uMode==MODE_AABB_STATIC_COLLISIONS) amrSphereStaticCollisions(gid);
    else if (uMode==MODE_AABB_REDUCE) { }
    else if (uMode==MODE_AABB_TREE_COLLISIONS) amrSphereTreeCollisions(gid);
    else if (uMode==MODE_AMR_SPHERE_SETUP) amrSphereSetup(gid);
    else if (uMode==MODE_AMR_SPHERE_TREE_COLLISIONS) amrSphereTreeCollisions(gid);
    else if (uMode==MODE_AMR_SPHERE_STATIC_COLLISIONS) amrSphereStaticCollisions(gid);
