void insertSphereContact(inout SphereContact contacts[4],inout int count,
                         SphereContact candidate){
    int slot;if(count<4)slot=count++;else{slot=3;if(candidate.depth<=contacts[slot].depth)return;}
    contacts[slot]=candidate;while(slot>0&&contacts[slot].depth>contacts[slot-1].depth){
        SphereContact swap=contacts[slot-1];contacts[slot-1]=contacts[slot];contacts[slot]=swap;--slot;}
