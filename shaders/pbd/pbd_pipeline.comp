#version 430

// Compute implementation of the Jacobi pipeline in fps_ray.c.  The C side
// deliberately supplies explicit particle indices: glued voxels share slots.
layout(local_size_x = 128) in;

struct ParticleState {
    vec4 pos_radius;
    vec4 prev_inv_mass;
    vec4 predicted_base_inv_mass;
    vec4 velocity;
};

struct VoxelState {
    uvec4 particle_0_3;
    uvec4 particle_4_7;
    vec4 pos_rest_edge;
    vec4 velocity_rest_volume;
    ivec4 flags;       // simulate, isBullet, type, simulateDOFs
    vec4 bounds_min;
    vec4 bounds_max;
    uvec4 lifecycle;   // skipVelocityFrames, wakeSource, gluedFaceMask, breakMask
};

struct StaticCollider {
    vec4 center;
    vec4 bounds_min;
    vec4 bounds_max;
};

struct AmrState {
    float latest[8];
    float previous[8];
};

struct AmrScratch {
    uvec4 position_sum;
    uvec4 velocity_sum_mass;
};

struct AabbState {
    vec4 previous_min;
    vec4 previous_max;
    vec4 predicted_min;
    vec4 predicted_max;
    ivec4 cell_level;
    uvec4 meta;
};

struct AmrControl {
    uint constraint_count, frame_refine_count, frame_coarsen_count, topology_generation;
    uint overflow, hierarchy_count, total_stage_count, levels;
    uint sample_count, use_deformation, particle_capacity, constraint_capacity;
    float curvature_threshold, threshold_factor;
    float deformation_coarse_fraction, deformation_fine_fraction;
    float mass_density;
    uint total_refine_count, total_coarsen_count, changed;
    uint padding[4];
};

struct AabbControl {
    uint proxy_count, candidate_count, contact_count, overflow;
    uint total_stage_count, enabled, mode, node_visit_count;
    uint bounds_reject_count, empty_reject_count, max_stack_depth, padding;
};

layout(std430, binding = 0) buffer ParticleBuffer { ParticleState particle[]; };
layout(std430, binding = 1) buffer CorrectionBuffer { uvec4 correction[]; };
layout(std430, binding = 2) buffer CellBuffer { ivec4 cell[]; };
layout(std430, binding = 3) buffer SimIdBuffer { uint simId[]; };
layout(std430, binding = 4) buffer VoxelBuffer { VoxelState voxel[]; };
layout(std430, binding = 5) buffer HashHeadBuffer { int hashHead[]; };
layout(std430, binding = 6) buffer HashNextBuffer { int hashNext[]; };
layout(std430, binding = 7) readonly buffer StaticCellBuffer { ivec4 staticCell[]; };
layout(std430, binding = 8) buffer TetherBuffer { int tetherOwner[]; };
layout(std430, binding = 9) buffer CollisionMetaBuffer { ivec4 collisionMeta[]; };
layout(std430, binding = 10) readonly buffer StaticColliderBuffer { StaticCollider staticCollider[]; };
layout(std430, binding = 11) readonly buffer RefcountBuffer { int particleRefcount[]; };
layout(std430, binding = 12) buffer ControlBuffer { ivec4 gpuControl; };
layout(std430, binding = 13) buffer CloneParentBuffer { int cloneParent[]; };
layout(std430, binding = 14) buffer DispatchBuffer { uint dispatchArgs[]; };
layout(std430, binding = 15) buffer TopologyBuffer { ivec4 topology[]; };
layout(std430, binding = 16) buffer AmrStateBuffer { AmrState amrState[]; };
layout(std430, binding = 17) buffer AmrScratchBuffer { AmrScratch amrScratch[]; };
layout(std430, binding = 18) buffer AmrControlBuffer { AmrControl amrControl; };
layout(std430, binding = 19) buffer AabbStateBuffer { AabbState aabbState[]; };
layout(std430, binding = 20) buffer AabbOwnerBuffer { uint aabbOwner[]; };
layout(std430, binding = 21) buffer AabbControlBuffer { AabbControl aabbControl; };
layout(std430, binding = 22) readonly buffer PartialBuffer { uint partial[]; };

uniform int uMode;
uniform int uParticleCount;
uniform int uSimCount;
uniform int uVoxelCount;
uniform int uVgsBegin;
uniform int uVgsCount;
uniform int uStaticColliderCount;
uniform int uHashSize;
uniform int uStaticHashSize;
uniform int uActivePlayers;
uniform float uDt;
uniform float uVoxelSize;
uniform float uParticleHashStep;
uniform float uFloorSize;
uniform float uGravity;
uniform float uVelocityDamping;
uniform float uSor;
uniform float uCollisionRelaxation;
uniform float uVgsAlpha;
uniform float uVgsBeta;
uniform float uVgsVolume;
uniform float uVgsEpsilon;
uniform float uStrainBreakThreshold;
uniform float uShearBreakThreshold;
uniform float uFractureProbability;
uniform int uFractureEvaluationSerial;
uniform float uTetherSpring;
uniform float uTetherDamping;
uniform int uBreakDampFrames;
uniform float uRestGridStep;
uniform vec4 uPlayerPosHalf[4]; // xyz position, w < 0 when inactive
uniform vec4 uTetherTarget[4];

const int MODE_RESET = 0;
const int MODE_INTEGRATE = 1;
const int MODE_HASH_CLEAR = 2;
const int MODE_HASH_BUILD = 3;
const int MODE_SCENE_COLLISIONS = 4;
const int MODE_PAIR_COLLISIONS = 5;
const int MODE_APPLY = 6;
const int MODE_VGS = 7;
const int MODE_STATIC_COLLISIONS = 8;
const int MODE_BREAK_MASK = 9;
const int MODE_FINALIZE_PARTICLES = 10;
const int MODE_FINALIZE_VOXELS = 11;
const int MODE_SPLIT_BREAKS = 12;
const int MODE_PREPARE_INDIRECT = 13;
const int MODE_WAKE_GATHER = 14;
const int MODE_WAKE_APPLY = 15;
const int MODE_TOPOLOGY_REBUILD_SERIAL = 16;
const int MODE_HIERARCHY_MASK = 17;
// Resident AMR is currently dispatched by the Metal backend. Keep mode values
// shared so C/Metal/GL validation cannot silently diverge.
const int MODE_AMR_CLEAR = 18;
const int MODE_AMR_SAMPLE = 19;
const int MODE_AMR_SAMPLE_COMPLETE = 20;
const int MODE_AMR_SELECT = 21;
const int MODE_AMR_RESOLVE = 22;
const int MODE_AMR_TRANSITION_CLEAR = 23;
const int MODE_AMR_TRANSITION_SCATTER = 24;
const int MODE_AMR_TRANSITION_APPLY = 25;
const int MODE_AMR_TOPOLOGY_APPLY = 26;
const int MODE_AMR_MASS_SCATTER = 27;
const int MODE_AMR_COMPACT = 28;
const int MODE_AMR_COMPILE = 29;
const int MODE_AMR_PREPARE_INDIRECT = 30;
const int MODE_AMR_DORMANT_SCATTER = 31;
const int MODE_AABB_CLEAR = 32;
const int MODE_AABB_BOUNDS = 33;
const int MODE_AABB_HASH_BUILD = 34;
const int MODE_AABB_COLLISIONS = 35;
const int MODE_AABB_STATIC_COLLISIONS = 36;
const int MODE_AABB_REDUCE = 37;
const int MODE_AABB_TREE_COLLISIONS = 38;
const int MODE_AMR_SPHERE_SETUP = 39;
const int MODE_AMR_SPHERE_TREE_COLLISIONS = 40;
const int MODE_AMR_SPHERE_STATIC_COLLISIONS = 41;
const int MODE_AMR_DORMANT_FULL_SNAPSHOT = 42;
const int MODE_AMR_BREAK_MASK = 43;
const int MODE_AMR_ACTIVE_CLEAR = 44;
const int MODE_AMR_PREPARE_TRANSITION = 45;
const int CONTROL_FLAG_OVERFLOW = 1;
const int CONTROL_FLAG_TOPOLOGY_DIRTY = 2;
const int CONTROL_FLAG_BREAK_OCCURRED = 4;
const uint AMR_OCCUPANCY_SHIFT = 8u;
const uint AMR_FORCE_REFINED = 1u << 10u;
const uint AMR_PARTIAL_EMBEDDED = 1u << 11u;
const uint AMR_REAL_MASK_SHIFT = 16u;
const uint AMR_DECISION_REFINE = 1u;
const uint AMR_DECISION_COARSEN = 2u;
const uint AMR_OVERFLOW_CONSTRAINT = 1u;
const uint AMR_OVERFLOW_PARTICLE = 2u;
const uint PARTIAL_NODE_WORDS = 144u;
const uint PARTIAL_REL_WORDS = 20u;
const uint PARTIAL_WELD_CHUNK = 32u;

uint voxelParticle(VoxelState v, int corner) {
    return (corner < 4) ? v.particle_0_3[corner] : v.particle_4_7[corner - 4];
}

uint hashCoord(ivec3 c, int size) {
    uint h = uint(c.x) * 73856093u;
    h ^= uint(c.y) * 19349663u;
    h ^= uint(c.z) * 83492791u;
    return h & uint(size - 1);
}

void atomicAddCorrection(uint id, int component, float value) {
    if (value == 0.0) return;
    uint expected = correction[id][component];
    for (;;) {
        float current = uintBitsToFloat(expected);
        uint desired = floatBitsToUint(current + value);
        uint observed = atomicCompSwap(correction[id][component], expected, desired);
        if (observed == expected) return;
        expected = observed;
    }
}

void accumulate(uint id, vec3 delta, float weight) {
    if (weight <= 0.0 || id >= uint(gpuControl.x)) return;
    atomicAddCorrection(id, 0, delta.x * weight);
    atomicAddCorrection(id, 1, delta.y * weight);
    atomicAddCorrection(id, 2, delta.z * weight);
    atomicAddCorrection(id, 3, weight);
}

vec3 projectOnto(vec3 onto, vec3 value) {
    float denom = dot(onto, onto);
    return (denom < uVgsEpsilon) ? vec3(0.0) : onto * (dot(onto, value) / denom);
}

void resetCorrections(uint gid) {
    if (gid >= uint(gpuControl.y)) return;
    uint id = simId[gid];
    if (particleRefcount[id] <= 0) return;
    correction[id] = uvec4(0u);
}

void integrateParticle(uint gid) {
    if (gid >= uint(gpuControl.y)) return;
    uint id = simId[gid];
    if (particleRefcount[id] <= 0) return;
    ParticleState p = particle[id];
    p.prev_inv_mass.xyz = p.pos_radius.xyz;
    p.predicted_base_inv_mass.xyz = p.pos_radius.xyz;
    if (p.prev_inv_mass.w > 0.0) {
        p.velocity.xyz *= uVelocityDamping;
        p.predicted_base_inv_mass.xyz += p.velocity.xyz * uDt;
        p.predicted_base_inv_mass.y -= uGravity * uDt * uDt;
        int tetherPlayer = tetherOwner[id];
        if (tetherPlayer >= 0 && tetherPlayer < 4) {
            float scale = uTetherTarget[tetherPlayer].w;
            vec3 accel = uTetherTarget[tetherPlayer].xyz * uTetherSpring * scale;
            p.predicted_base_inv_mass.xyz += accel * uDt * uDt;
            p.velocity.xyz += accel * uDt;
            float damp = clamp(uTetherDamping * scale * uDt, 0.0, 0.9);
            vec3 disp = p.predicted_base_inv_mass.xyz - p.prev_inv_mass.xyz;
            p.predicted_base_inv_mass.xyz = p.prev_inv_mass.xyz + disp * (1.0 - damp);
            p.velocity.xyz *= 1.0 - damp;
        }
    }
    particle[id] = p;
}

void clearHash(uint gid) {
    if (gid < uint(uHashSize)) hashHead[gid] = -1;
}

void buildHash(uint gid) {
    if (gid >= dispatchArgs[8]) return;
    uint id = simId[uint(gpuControl.z) + gid];
    if (particleRefcount[id] <= 0) return;
    ivec3 c = ivec3(floor(particle[id].predicted_base_inv_mass.xyz / uParticleHashStep));
    cell[id].xyz = c;
    uint h = hashCoord(c, uHashSize);
    hashNext[gid] = atomicExchange(hashHead[h], int(gid));
}

void pairCollisions(uint gid) {
    if (gid >= dispatchArgs[8]) return;
    uint aid = simId[uint(gpuControl.z) + gid];
    if (particleRefcount[aid] <= 0) return;
    ParticleState a = particle[aid];
    float wa = a.prev_inv_mass.w;
    if (wa <= 0.0) return;
    const float eps = 1e-6;

    vec3 scenePos = a.predicted_base_inv_mass.xyz;
    float sceneRadius = a.pos_radius.w;
    for (int playerIndex = 0; playerIndex < uActivePlayers && playerIndex < 4; ++playerIndex) {
        if (uPlayerPosHalf[playerIndex].w < 0.0) continue;
        float halfSize = uPlayerPosHalf[playerIndex].w;
        vec3 nearest = clamp(scenePos, uPlayerPosHalf[playerIndex].xyz - vec3(halfSize),
                                      uPlayerPosHalf[playerIndex].xyz + vec3(halfSize));
        vec3 sceneDelta = scenePos - nearest;
        float sceneDistSq = dot(sceneDelta, sceneDelta);
        if (sceneDistSq < sceneRadius * sceneRadius) {
            float sceneDist = sqrt(max(sceneDistSq, eps));
            float penetration = sceneRadius - sceneDist;
            vec3 normal = (sceneDist > eps) ? -sceneDelta / sceneDist : vec3(0.0, 1.0, 0.0);
            scenePos += normal * penetration;
        }
    }
    accumulate(aid, scenePos - a.predicted_base_inv_mass.xyz, 1.0);

    ivec3 ac = cell[aid].xyz;
    for (int dz = -1; dz <= 1; ++dz) {
        for (int dy = -1; dy <= 1; ++dy) {
            for (int dx = -1; dx <= 1; ++dx) {
                if (dz < 0 || (dz == 0 && dy < 0) ||
                    (dz == 0 && dy == 0 && dx < 0)) continue;
                ivec3 nc = ac + ivec3(dx, dy, dz);
                int item = hashHead[hashCoord(nc, uHashSize)];
                int traversed = 0;
                while (item >= 0 && item < int(dispatchArgs[8]) && traversed < int(dispatchArgs[8])) {
                    ++traversed;
                    bool sameCell = (dx == 0 && dy == 0 && dz == 0);
                    if (!sameCell || uint(item) > gid) {
                            uint bid = simId[uint(gpuControl.z) + uint(item)];
                            if (particleRefcount[bid] <= 0) { item = hashNext[item]; continue; }
                        if (all(equal(cell[bid].xyz, nc))) {
                            ParticleState b = particle[bid];
                            ivec4 metaA = collisionMeta[aid];
                            ivec4 metaB = collisionMeta[bid];
                            if (metaA.w >= 0 && metaA.w == metaB.w) {
                                vec3 restDelta = vec3(metaA.xyz - metaB.xyz) * uRestGridStep;
                                float restTarget = a.pos_radius.w + b.pos_radius.w + 1e-5;
                                if (dot(restDelta, restDelta) <= restTarget * restTarget) {
                                    item = hashNext[item];
                                    continue;
                                }
                            }
                            float wb = b.prev_inv_mass.w;
                            float wsum = wa + wb;
                            vec3 delta = a.predicted_base_inv_mass.xyz - b.predicted_base_inv_mass.xyz;
                            float distSq = dot(delta, delta);
                            float target = a.pos_radius.w + b.pos_radius.w;
                            if (wsum > 0.0 && distSq < target * target) {
                                float dist = sqrt(max(distSq, eps));
                                float penetration = target - dist;
                                if (penetration > 0.0) {
                                    vec3 normal = (dist > eps) ? delta / dist : vec3(1.0, 0.0, 0.0);
                                    float scale = uCollisionRelaxation * (0.5 * penetration) / wsum;
                                    int maxTimer = max(cell[aid].w, cell[bid].w);
                                    float damp = (uBreakDampFrames > 0)
                                        ? clamp(1.0 - float(maxTimer) / float(uBreakDampFrames), 0.0, 1.0)
                                        : 1.0;
                                    if (wa > 0.0) accumulate(aid, normal * (scale * wa * damp), 1.0);
                                    if (wb > 0.0) accumulate(bid, normal * (-scale * wb * damp), 1.0);
                                }
                            }
                        }
                    }
                    item = hashNext[item];
                }
                if (item >= 0 && item < int(dispatchArgs[8])) atomicAdd(dispatchArgs[11], 1u);
            }
        }
    }
}

void applyCorrections(uint gid) {
    if (gid >= uint(gpuControl.y)) return;
    uint id = simId[gid];
    if (particleRefcount[id] <= 0) return;
    uvec4 bits = correction[id];
    float weight = uintBitsToFloat(bits.w);
    if (weight > 0.0) {
        vec3 sum = vec3(uintBitsToFloat(bits.x), uintBitsToFloat(bits.y), uintBitsToFloat(bits.z));
        particle[id].predicted_base_inv_mass.xyz += sum * (uSor / weight);
    }
    correction[id] = uvec4(0u);
}

// Separable, precomputed factors of A and R=(A^T A)^-1 A^T.
bool amrPartial(VoxelState v);
uint partialNodeBase(uint stage);
float partialFloat(uint index);
void amrLoadCorners(uint stage,VoxelState v,bool predicted,out vec3 corners[8]);
const float WELD_A[6] = float[6](1.0, 0.0, 0.5, 0.5, 0.0, 1.0);
const float WELD_R[6] = float[6](5.0/6.0, 1.0/3.0, -1.0/6.0,
                                  -1.0/6.0, 1.0/3.0, 5.0/6.0);

void scatterHierarchyWeld(uint voxelId, uint terminalMask, bool includeCoarsening) {
    VoxelState parent = voxel[voxelId];
    // The break pass runs before projection and may disable this parent after
    // the flat constraint list was built. Suppress its stale weld immediately.
    if (parent.flags.x == 0) return;
    for (int c = 0; c < 8; ++c) {
        uint child = floatBitsToUint(c < 4 ? parent.bounds_min[c] : parent.bounds_max[c - 4]);
        if (voxel[child].flags.x == 0) terminalMask &= ~(1u << c);
    }
    if (terminalMask == 0u) return;
    includeCoarsening = includeCoarsening && terminalMask == 0xffu;
    uint fineId[27];
    vec3 finePos[27], coarsePos[8];
    for (int c = 0; c < 8; ++c) {
        uint id = voxelParticle(parent, c);
        if (id >= uint(gpuControl.x)) return;
        uint child = floatBitsToUint(c < 4 ? parent.bounds_min[c] : parent.bounds_max[c - 4]);
        if ((terminalMask & (1u << c)) != 0u && voxel[child].flags.w == 0) return;
        coarsePos[c] = particle[id].predicted_base_inv_mass.xyz;
    }
    for (int r = 0; r < 27; ++r) {
        int gx = r % 3, gy = (r / 3) % 3, gz = r / 9;
        int childCorner = int(gx == 2) | (int(gy == 2) << 1) | (int(gz == 2) << 2);
        int localCorner = int(gx != 0) | (int(gy != 0) << 1) | (int(gz != 0) << 2);
        uint child = floatBitsToUint(childCorner < 4 ? parent.bounds_min[childCorner]
                                                     : parent.bounds_max[childCorner - 4]);
        uint id = voxelParticle(voxel[child], localCorner);
        if (id >= uint(gpuControl.x)) return;
        fineId[r] = id;
        finePos[r] = particle[id].predicted_base_inv_mass.xyz;
    }
    for (int r = 0; r < 27; ++r) {
        int gx = r % 3, gy = (r / 3) % 3, gz = r / 9;
        if (gx != 1 && gy != 1 && gz != 1) continue;
        bool covered = false;
        for (int c = 0; c < 8; ++c) {
            if ((terminalMask & (1u << c)) == 0u) continue;
            int cx = c & 1, cy = (c >> 1) & 1, cz = (c >> 2) & 1;
            covered = covered || (gx >= cx && gx <= cx + 1 &&
                                  gy >= cy && gy <= cy + 1 && gz >= cz && gz <= cz + 1);
        }
        if (!covered) continue;
        float weight = particle[fineId[r]].prev_inv_mass.w;
        if (weight <= 0.0) continue;
        vec3 target = vec3(0.0);
        for (int c = 0; c < 8; ++c) {
            float w = WELD_A[2*gx+(c&1)] * WELD_A[2*gy+((c>>1)&1)] *
                      WELD_A[2*gz+((c>>2)&1)];
            target += coarsePos[c] * w;
        }
        accumulate(fineId[r], target - finePos[r], weight);
    }
    if (!includeCoarsening) return;
    for (int c = 0; c < 8; ++c) {
        uint id = voxelParticle(parent, c);
        float weight = particle[id].prev_inv_mass.w;
        if (weight <= 0.0) continue;
        vec3 target = vec3(0.0);
        for (int r = 0; r < 27; ++r) {
            int gx = r % 3, gy = (r / 3) % 3, gz = r / 9;
            float w = WELD_R[3*(c&1)+gx] * WELD_R[3*((c>>1)&1)+gy] *
                      WELD_R[3*((c>>2)&1)+gz];
            target += finePos[r] * w;
        }
        accumulate(id, target - coarsePos[c], weight);
    }
}

void solveVgs(uint gid) {
    VoxelState v = voxel[uint(uVgsBegin) + gid];
    if (v.flags.x == 0 || v.flags.y != 0 || v.flags.z != 0 || v.flags.w == 0) return;
    vec3 p[8];
    vec3 original[8];
    float applyWeight[8];
    bool dynamicParticle = false;
    for (int i = 0; i < 8; ++i) {
        uint id = voxelParticle(v, i);
        if (id >= uint(gpuControl.x)) return;
        p[i] = particle[id].predicted_base_inv_mass.xyz;
        original[i] = p[i];
        float w = particle[id].prev_inv_mass.w;
        applyWeight[i] = (w > 0.0) ? w : 0.0;
        dynamicParticle = dynamicParticle || (w > 0.0);
    }
    if (!dynamicParticle) return;
    bool embedded=amrPartial(v);
    uint nodeBase=embedded?partialNodeBase(uint(uVgsBegin)+gid):0u;
    if(embedded){amrLoadCorners(uint(uVgsBegin)+gid,v,true,p);
        for(int c=0;c<8;++c)original[c]=p[c];}

    float restEdge = v.pos_rest_edge.w;
    float restVolume = v.velocity_rest_volume.w;
    float sizeRatio = clamp(uParticleHashStep / restEdge, 0.0, 1.0);
    float strengthScale = sizeRatio * sizeRatio;
    int level = clamp(int(round(log2(max(restEdge / max(uParticleHashStep, uVgsEpsilon), 1.0)))), 0, 5);
    const float shearFit[6] = float[6](1.0, 0.167465888, 0.147586011, 0.143609412, 0.142652311, 0.142450549);
    const float compressionFit[6] = float[6](1.0, 0.332471773, 0.285779610, 0.276316121, 0.274034485, 0.274624392);
    float vgsAlpha = uVgsAlpha * strengthScale * shearFit[level];
    float vgsBeta = 1.0 - (1.0 - uVgsBeta) * strengthScale * compressionFit[level];
    float vgsVolume = uVgsVolume * strengthScale * compressionFit[level];
    for (int iteration = 0; iteration < 3; ++iteration) {
        vec3 centerPos = vec3(0.0);
        for (int i = 0; i < 8; ++i) centerPos += p[i];
        centerPos *= 0.125;
        vec3 v0 = ((p[1]-p[0]) + (p[3]-p[2]) + (p[5]-p[4]) + (p[7]-p[6])) * 0.25;
        vec3 v1 = ((p[2]-p[0]) + (p[3]-p[1]) + (p[6]-p[4]) + (p[7]-p[5])) * 0.25;
        vec3 v2 = ((p[4]-p[0]) + (p[5]-p[1]) + (p[6]-p[2]) + (p[7]-p[3])) * 0.25;
        vec3 u0 = v0 - vgsAlpha * (projectOnto(v1, v0) + projectOnto(v2, v0));
        vec3 u1 = v1 - vgsAlpha * (projectOnto(v2, v1) + projectOnto(v0, v1));
        vec3 u2 = v2 - vgsAlpha * (projectOnto(v0, v2) + projectOnto(v1, v2));
        float target0 = mix(restEdge, length(v0), vgsBeta);
        float target1 = mix(restEdge, length(v1), vgsBeta);
        float target2 = mix(restEdge, length(v2), vgsBeta);
        if (length(u0) > uVgsEpsilon) u0 *= target0 / length(u0);
        if (length(u1) > uVgsEpsilon) u1 *= target1 / length(u1);
        if (length(u2) > uVgsEpsilon) u2 *= target2 / length(u2);
        float volume = dot(cross(u0, u1), u2);
        float root = 1.0;
        if (vgsVolume > 0.0 && abs(volume) > uVgsEpsilon) {
            float targetVolume = mix(volume, restVolume, vgsVolume);
            float scale = targetVolume / volume;
            root = pow(abs(scale), 1.0/3.0) * ((scale < 0.0) ? -1.0 : 1.0);
        }
        u0 *= 0.5 * root; u1 *= 0.5 * root; u2 *= 0.5 * root;
        vec3 nextP[8];
        nextP[0]=centerPos-u0-u1-u2; nextP[1]=centerPos+u0-u1-u2;
        nextP[2]=centerPos-u0+u1-u2; nextP[3]=centerPos+u0+u1-u2;
        nextP[4]=centerPos-u0-u1+u2; nextP[5]=centerPos+u0-u1+u2;
        nextP[6]=centerPos-u0+u1+u2; nextP[7]=centerPos+u0+u1+u2;
        for (int i = 0; i < 8; ++i) p[i] = nextP[i];
    }
    if(embedded){uint rank=partial[nodeBase+2u];float fraction=partialFloat(nodeBase+3u);
        for(uint a=0u;a<rank;++a){if(applyWeight[a]<=0.0)continue;vec3 delta=vec3(0.0);
            for(uint c=0u;c<8u;++c)delta+=(p[c]-original[c])*
                partialFloat(nodeBase+76u+a*8u+c);
            accumulate(voxelParticle(v,int(a)),delta*fraction,applyWeight[a]);}}
    else for (int i = 0; i < 8; ++i) {
        if (applyWeight[i] > 0.0) accumulate(voxelParticle(v, i), p[i] - original[i], applyWeight[i]);
    }
}

void propagateHierarchyMask(uint gid) {
    if (gid >= uint(uVgsCount)) return;
    uint id = uint(uVgsBegin) + gid;
    if (voxel[id].flags.x == 0) return;
    VoxelState parent = voxel[id];
    for (int c = 0; c < 8; ++c) {
        uint child = floatBitsToUint(c < 4 ? parent.bounds_min[c] : parent.bounds_max[c - 4]);
        if (voxel[child].flags.x == 0) {
            voxel[id].flags.x = 0;
            return;
        }
    }
}

int findStaticCell(ivec3 coord) {
    uint h = hashCoord(coord, uStaticHashSize);
    for (int probe = 0; probe < uStaticHashSize; ++probe) {
        ivec4 entry = staticCell[h];
        if (entry.w == -1) return -1;
        if (all(equal(entry.xyz, coord))) return entry.w;
        h = (h + 1u) & uint(uStaticHashSize - 1);
    }
    return -1;
}

vec3 pushOutOfBox(vec3 pos, float radius, StaticCollider box) {
    vec3 bmin = box.bounds_min.xyz;
    vec3 bmax = box.bounds_max.xyz;
    bool inside = all(greaterThanEqual(pos, bmin)) && all(lessThanEqual(pos, bmax));
    const float eps = 1e-6;
    if (!inside) {
        vec3 closest = clamp(pos, bmin, bmax);
        vec3 delta = pos - closest;
        float distSq = dot(delta, delta);
        if (distSq >= radius * radius) return pos;
        float dist = sqrt(max(distSq, eps));
        float penetration = radius - dist;
        vec3 normal = (dist > eps) ? delta / dist : vec3(0.0, 1.0, 0.0);
        return pos + normal * max(penetration, 0.0);
    }
    float topGap = bmax.y - pos.y;
    float bottomGap = pos.y - bmin.y;
    float verticalBias = uVoxelSize * 0.25;
    bool preferTop = (pos.y >= box.center.y) && (topGap <= radius + verticalBias);
    bool preferBottom = (pos.y < box.center.y) && (bottomGap <= radius + verticalBias);
    if (preferTop || preferBottom) {
        bool top = preferTop && (!preferBottom || topGap <= bottomGap);
        vec3 normal = top ? vec3(0.0, 1.0, 0.0) : vec3(0.0, -1.0, 0.0);
        float gap = top ? topGap : bottomGap;
        float penetration = radius - gap;
        if (penetration < 0.0) penetration = radius;
        return pos + normal * penetration;
    }
    vec3 low = pos - bmin;
    vec3 high = bmax - pos;
    float distances[6] = float[6](low.x, high.x, low.y, high.y, low.z, high.z);
    int best = 0;
    for (int i = 1; i < 6; ++i) if (distances[i] < distances[best]) best = i;
    vec3 normal = vec3(0.0);
    if (best == 0) normal.x=-1.0; else if (best == 1) normal.x=1.0;
    else if (best == 2) normal.y=-1.0; else if (best == 3) normal.y=1.0;
    else if (best == 4) normal.z=-1.0; else normal.z=1.0;
    return pos + normal * (radius + distances[best]);
}

vec3 pushOutOfPatch(vec3 pos, float radius, StaticCollider surfacePatch) {
    vec3 closest = clamp(pos, surfacePatch.bounds_min.xyz, surfacePatch.bounds_max.xyz);
    vec3 normal = surfacePatch.center.xyz;
    vec3 delta = pos - closest;
    float signedDistance = dot(delta, normal);
    bool projectedInside;
    if (normal.x != 0.0) projectedInside = pos.y >= surfacePatch.bounds_min.y && pos.y <= surfacePatch.bounds_max.y && pos.z >= surfacePatch.bounds_min.z && pos.z <= surfacePatch.bounds_max.z;
    else if (normal.y != 0.0) projectedInside = pos.x >= surfacePatch.bounds_min.x && pos.x <= surfacePatch.bounds_max.x && pos.z >= surfacePatch.bounds_min.z && pos.z <= surfacePatch.bounds_max.z;
    else projectedInside = pos.x >= surfacePatch.bounds_min.x && pos.x <= surfacePatch.bounds_max.x && pos.y >= surfacePatch.bounds_min.y && pos.y <= surfacePatch.bounds_max.y;
    if (projectedInside && signedDistance < 0.0 && signedDistance >= -radius) return pos + normal * (radius - signedDistance);
    if (signedDistance < 0.0) return pos;
    float distanceSq = dot(delta, delta);
    if (distanceSq >= radius * radius) return pos;
    float distance = sqrt(max(distanceSq, 1e-6));
    vec3 direction = distance > 1e-6 ? delta / distance : normal;
    return pos + direction * (radius - distance);
}

void staticCollisions(uint gid) {
    if (gid >= dispatchArgs[8]) return;
    uint id = simId[uint(gpuControl.z) + gid];
    if (particleRefcount[id] <= 0) return;
    ParticleState p = particle[id];
    if (p.prev_inv_mass.w <= 0.0) return;
    float radius = p.pos_radius.w;
    vec3 pos = p.predicted_base_inv_mass.xyz;
    float terrainLimit = uFloorSize - radius;
    float floorLimit = max(0.0, 0.5 * uVoxelSize - radius);
    bool floorContact = pos.y < floorLimit;
    pos.y = max(pos.y, floorLimit);
    if (floorContact) p.prev_inv_mass.xz = pos.xz -
        (pos.xz - p.prev_inv_mass.xz) * 0.05;
    pos.xz = clamp(pos.xz, vec2(-terrainLimit), vec2(terrainLimit));
    const float eps = 1e-6;
    for (int i = 0; i < uActivePlayers && i < 4; ++i) {
        if (uPlayerPosHalf[i].w < 0.0) continue;
        float halfSize = uPlayerPosHalf[i].w;
        vec3 nearest = clamp(pos, uPlayerPosHalf[i].xyz - vec3(halfSize),
                                  uPlayerPosHalf[i].xyz + vec3(halfSize));
        vec3 delta = pos - nearest;
        float distSq = dot(delta, delta);
        if (distSq < radius * radius) {
            float dist = sqrt(max(distSq, eps));
            vec3 normal = (dist > eps) ? delta / dist : vec3(0.0, 1.0, 0.0);
            pos += normal * (radius - dist);
        }
    }
    ivec3 center = ivec3(floor(pos / uVoxelSize));
    int seen[128]; int seenCount = 0;
    int reach = 0.5 * radius > uVoxelSize ? int(ceil(0.5 * radius / uVoxelSize)) + 1 : 1;
    for (int z=-reach; z<=reach; ++z) for (int y=-reach; y<=reach; ++y) for (int x=-reach; x<=reach; ++x) {
        int item = findStaticCell(center + ivec3(x,y,z));
        if (dispatchArgs[12] == 0u && item <= -2) {
            int colliderId = -item - 2;
            if (colliderId >= 0 && colliderId < uStaticColliderCount)
                pos = pushOutOfBox(pos, 0.5 * radius, staticCollider[colliderId]);
            continue;
        }
        while (item >= 0 && item < uStaticColliderCount) {
            StaticCollider surfacePatch = staticCollider[item];
            int patchId = floatBitsToInt(surfacePatch.bounds_min.w);
            bool duplicate = false;
            for (int s=0; s<seenCount; ++s) duplicate = duplicate || (seen[s] == patchId);
            if (!duplicate && seenCount < 128) {
                seen[seenCount++] = patchId;
                pos = pushOutOfPatch(pos, 0.5 * radius, surfacePatch);
            }
            item = floatBitsToInt(surfacePatch.center.w);
        }
    }
    center = ivec3(floor(pos / uVoxelSize));
    int recovery = findStaticCell(center);
    if (recovery <= -2) {
        int colliderId = -recovery - 2;
        if (colliderId >= 0 && colliderId < uStaticColliderCount)
            pos = pushOutOfBox(pos, 0.5 * radius, staticCollider[colliderId]);
    }
    p.predicted_base_inv_mass.xyz = pos;
    particle[id] = p;
}

int topologyNeighbor(int voxelId, int face);

uint fractureHash(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

bool fractureProbabilityAccepts(uint identity) {
    uint sampleBits = fractureHash(
        identity ^ uint(uFractureEvaluationSerial) * 0x9e3779b9u);
    float randomSample = float(sampleBits) * (1.0 / 4294967296.0);
    return randomSample < uFractureProbability;
}

void gatherBreakMask(uint gid) {
    uint voxelId;
    if(uMode==MODE_AMR_BREAK_MASK){
        uint activeBase=16u+4u*amrControl.constraint_capacity;
        if(gid>=dispatchArgs[activeBase])return;
        voxelId=dispatchArgs[activeBase+4u+gid];
    }else{
        if(gid>=uint(uVgsCount))return;
        voxelId=uint(uVgsBegin)+gid;
    }
    VoxelState v = voxel[voxelId];
    if (v.flags.x == 0 || v.flags.w == 0 || v.flags.y != 0 ||
        v.flags.z != 0 || v.pos_rest_edge.w <= 0.0) {
        voxel[voxelId] = v; return;
    }
    vec3 p[8];
    for (int i=0; i<8; ++i) {
        uint id=voxelParticle(v,i); if (id>=uint(gpuControl.x)) return;
        if (tetherOwner[id] >= 0) return;
        p[i]=particle[id].predicted_base_inv_mass.xyz;
    }
    if(amrPartial(v))amrLoadCorners(voxelId,v,true,p);
    vec3 axis0=((p[1]-p[0])+(p[3]-p[2])+(p[5]-p[4])+(p[7]-p[6]))*0.25;
    vec3 axis1=((p[2]-p[0])+(p[3]-p[1])+(p[6]-p[4])+(p[7]-p[5]))*0.25;
    vec3 axis2=((p[4]-p[0])+(p[5]-p[1])+(p[6]-p[2])+(p[7]-p[3]))*0.25;
    vec3 lengths=vec3(length(axis0),length(axis1),length(axis2));
    vec3 strain=abs(lengths-vec3(v.pos_rest_edge.w))/v.pos_rest_edge.w;
    uint glued=v.lifecycle.z; uint mask=0u; bool exceeded=false;
    if (strain.x>uStrainBreakThreshold) { exceeded=true; mask |= glued & ((1u<<0)|(1u<<1)); }
    if (strain.y>uStrainBreakThreshold) { exceeded=true; mask |= glued & ((1u<<2)|(1u<<3)); }
    if (strain.z>uStrainBreakThreshold) { exceeded=true; mask |= glued & ((1u<<4)|(1u<<5)); }
    vec3 n0=(lengths.x>uVgsEpsilon)?axis0/lengths.x:vec3(0.0);
    vec3 n1=(lengths.y>uVgsEpsilon)?axis1/lengths.y:vec3(0.0);
    vec3 n2=(lengths.z>uVgsEpsilon)?axis2/lengths.z:vec3(0.0);
    if (abs(dot(n0,n1))>uShearBreakThreshold) { exceeded=true; mask |= glued & ((1u<<4)|(1u<<5)); }
    if (abs(dot(n0,n2))>uShearBreakThreshold) { exceeded=true; mask |= glued & ((1u<<2)|(1u<<3)); }
    if (abs(dot(n1,n2))>uShearBreakThreshold) { exceeded=true; mask |= glued & ((1u<<0)|(1u<<1)); }
    const float hingeCosLimit = 0.9396926208; // cos(20 degrees)
    const int faceCorners[24] = int[24](
        1,3,5,7, 0,2,4,6, 2,3,6,7,
        0,1,4,5, 4,5,6,7, 0,1,2,3);
    for (int face=0; face<6; ++face) {
        if ((glued & (1u<<face)) == 0u) continue;
        int sharedCornerCount = 0;
        for (int c=0; c<4; ++c) {
            uint sharedId = voxelParticle(v, faceCorners[face*4+c]);
            if (sharedId < uint(gpuControl.x) && particleRefcount[sharedId] > 1)
                ++sharedCornerCount;
        }
        if (sharedCornerCount > 1) continue;
        int neighborId = topologyNeighbor(int(voxelId), face);
        if (neighborId < 0 || neighborId >= uVoxelCount) continue;
        VoxelState neighbor = voxel[neighborId];
        if (neighbor.flags.x == 0 || neighbor.flags.y != 0 || neighbor.flags.z != 0) continue;
        vec3 q[8];
        for (int i=0; i<8; ++i) {
            uint id=voxelParticle(neighbor,i); if (id>=uint(gpuControl.x)) return;
            q[i]=particle[id].predicted_base_inv_mass.xyz;
        }
        vec3 m0=normalize(((q[1]-q[0])+(q[3]-q[2])+(q[5]-q[4])+(q[7]-q[6]))*0.25);
        vec3 m1=normalize(((q[2]-q[0])+(q[3]-q[1])+(q[6]-q[4])+(q[7]-q[5]))*0.25);
        vec3 m2=normalize(((q[4]-q[0])+(q[5]-q[1])+(q[6]-q[2])+(q[7]-q[3]))*0.25);
        if (dot(n0,m0)<hingeCosLimit || dot(n1,m1)<hingeCosLimit || dot(n2,m2)<hingeCosLimit) {
            exceeded=true; mask |= 1u<<face;
        }
    }
    if (exceeded && fractureProbabilityAccepts(voxelId)) {
        v.flags.x = 0; // Deactivate VGS constraint
        v.lifecycle.y = 1u; // wake_source = true
        v.lifecycle.z = 0u; // Clear glued faces
    }
    voxel[voxelId] = v;
}

void splitBrokenFaces(uint gid) {
    // No-op in VGS-as-glue model: fracture never splits or clones particles.
}

int topologyNeighbor(int voxelId, int face) {
    return (face < 4) ? topology[voxelId * 2][face]
                      : topology[voxelId * 2 + 1][face - 4];
}

int topologyRoot(int voxelId) {
    int root = voxelId;
    for (int i = 0; i < 32; ++i) {
        int parent = topology[root * 2 + 1].z;
        if (parent == root || parent < 0 || parent >= uVoxelCount) break;
        root = parent;
    }
    return root;
}

void topologyUnion(uint gid) {
    if ((gpuControl.w & CONTROL_FLAG_TOPOLOGY_DIRTY) == 0 || gid >= uint(uVoxelCount)) return;
    VoxelState v = voxel[gid];
    if ((v.lifecycle.z & 0x80000000u) == 0u) return;
    for (int face = 0; face < 6; ++face) {
        if ((v.lifecycle.z & (1u << face)) == 0u) continue;
        int neighbor = topologyNeighbor(int(gid), face);
        if (neighbor < 0 || neighbor >= uVoxelCount) continue;
        if ((voxel[neighbor].lifecycle.z & 0x80000000u) == 0u) continue;
        for (int attempt = 0; attempt < 32; ++attempt) {
            int a = topologyRoot(int(gid));
            int b = topologyRoot(neighbor);
            if (a == b) break;
            int high = max(a, b), low = min(a, b);
            int old = atomicCompSwap(topology[high * 2 + 1].z, high, low);
            if (old == high || old == low) break;
        }
    }
}

void assignParticleGroup(uint id, int group) {
    for (;;) {
        int old = collisionMeta[id].w;
        if (old == group || old == -2) return;
        int next = (old == -1) ? group : -2;
        if (atomicCompSwap(collisionMeta[id].w, old, next) == old) return;
    }
}

void topologyAssignParticles(uint gid) {
    if ((gpuControl.w & CONTROL_FLAG_TOPOLOGY_DIRTY) == 0 || gid >= uint(uVoxelCount)) return;
    VoxelState v = voxel[gid];
    if ((v.lifecycle.z & 0x80000000u) == 0u || v.flags.y != 0 || v.flags.z != 0) return;
    int group = topologyRoot(int(gid));
    for (int corner = 0; corner < 8; ++corner) {
        uint id = voxelParticle(v, corner);
        if (id < uint(gpuControl.x) && particleRefcount[id] > 0 &&
            particle[id].predicted_base_inv_mass.w > 0.0) assignParticleGroup(id, group);
    }
}

void topologyRebuildSerial(uint gid) {
    // No-op matching Metal pipeline: topology rebuild is handled via resident graph updates.
}

void wakeGather(uint gid) {
    if (gid >= uint(uVoxelCount)) return;
    VoxelState v = voxel[gid];
    if (v.flags.x == 0 || v.flags.y != 0) return;
    bool wake = v.lifecycle.y != 0u;
    if (!wake) {
        for (int face = 0; face < 6; ++face) {
            int neighbor = topologyNeighbor(int(gid), face);
            if (neighbor >= 0 && neighbor < uVoxelCount && voxel[neighbor].flags.y == 0 &&
                voxel[neighbor].lifecycle.y != 0u) { wake = true; break; }
        }
    }
    int timer = max(int(v.bounds_min.w) - 1, 0);
    if (wake) timer = 30;
    v.bounds_min.w = float(timer);
    voxel[gid] = v;
}

void wakeApply(uint gid) {
    // No-op: wakeGather writes directly to bounds_min.w
}

void prepareIndirect(uint gid) {
    if (gid != 0u) return;
    dispatchArgs[0] = (uint(max(gpuControl.y, 0)) + 127u) / 128u;
    dispatchArgs[1] = 1u;
    dispatchArgs[2] = 1u;
    dispatchArgs[3] = 0u;
    dispatchArgs[4] = (dispatchArgs[8] + 127u) / 128u;
    dispatchArgs[5] = 1u;
    dispatchArgs[6] = 1u;
    dispatchArgs[7] = 0u;
}

void finalizeParticle(uint gid) {
    if (gid >= uint(gpuControl.y)) return;
    uint id=simId[gid]; ParticleState p=particle[id];
    if (particleRefcount[id] <= 0) return;
    vec3 delta=p.predicted_base_inv_mass.xyz-p.prev_inv_mass.xyz;
    p.velocity.xyz=(p.prev_inv_mass.w>0.0 && uDt>0.0)?delta/uDt:vec3(0.0);
    p.pos_radius.xyz=p.predicted_base_inv_mass.xyz;
    if (cell[id].w>0) cell[id].w--;
    particle[id]=p;
}

void finalizeVoxel(uint gid) {
    if (gid >= uint(uVoxelCount)) return;
    VoxelState v=voxel[gid];
    if (v.flags.x==0 || v.flags.y!=0 || v.flags.z!=0) return;
    vec3 centerPos=vec3(0.0), previous=vec3(0.0);
    for (int i=0;i<8;++i) {
        uint id=voxelParticle(v,i); if(id>=uint(gpuControl.x)) return;
        centerPos+=particle[id].predicted_base_inv_mass.xyz;
        previous+=particle[id].prev_inv_mass.xyz;
    }
    centerPos*=0.125; previous*=0.125;
    if (v.lifecycle.x==0u && uDt>0.0) v.velocity_rest_volume.xyz=(centerPos-previous)/uDt;
    else if (v.lifecycle.x>0u) v.lifecycle.x--;
    v.pos_rest_edge.xyz=centerPos; voxel[gid]=v;
}

uint amrOccupancy(VoxelState v) {
    return (v.lifecycle.w >> AMR_OCCUPANCY_SHIFT) & 3u;
}

uint amrRealMask(VoxelState v) {
    return (v.lifecycle.w >> AMR_REAL_MASK_SHIFT) & 0xffu;
}
bool amrPartial(VoxelState v){return (v.lifecycle.w&AMR_PARTIAL_EMBEDDED)!=0u;}
bool amrRepresented(VoxelState v){return (amrOccupancy(v)==2u||amrPartial(v))&&
    amrRealMask(v)==0xffu;}
uint partialNodeBase(uint stage){return (stage-uint(uVoxelCount))*PARTIAL_NODE_WORDS;}
uint partialRelationBase(uint relation){return amrControl.hierarchy_count*PARTIAL_NODE_WORDS+
    relation*PARTIAL_REL_WORDS;}
uint partialChunkMaskBase(){return amrControl.hierarchy_count*PARTIAL_NODE_WORDS+
    amrControl.padding[0]*PARTIAL_REL_WORDS+amrControl.padding[1]+1u+
    amrControl.padding[0]+amrControl.padding[2]+amrControl.padding[3];}
float partialFloat(uint index){return uintBitsToFloat(partial[index]);}
void amrLoadCorners(uint stage,VoxelState v,bool predicted,out vec3 corners[8]){
    vec3 anchor[8];for(int a=0;a<8;++a){uint id=voxelParticle(v,a);
        anchor[a]=id<uint(gpuControl.x)?(predicted?
            particle[id].predicted_base_inv_mass.xyz:particle[id].pos_radius.xyz):vec3(0.0);}
    if(!amrPartial(v)){for(int c=0;c<8;++c)corners[c]=anchor[c];return;}
    uint base=partialNodeBase(stage),rank=partial[base+2u];
    for(int c=0;c<8;++c){vec3 p=vec3(0.0);for(uint a=0u;a<rank;++a)
        p+=anchor[a]*partialFloat(base+12u+uint(c)*8u+a);corners[c]=p;}
}

uint amrChild(VoxelState parent, int corner) {
    return floatBitsToUint(corner < 4 ? parent.bounds_min[corner]
                                      : parent.bounds_max[corner - 4]);
}

bool amrHasActiveChildren(VoxelState parent) {
    for (int c = 0; c < 8; ++c) {
        uint child = amrChild(parent, c);
        if (child < amrControl.total_stage_count && voxel[child].flags.w != 0) return true;
    }
    return false;
}

uint amrTerminalMask(VoxelState parent);

void scatterPartialWeld(uint stage,uint chunk){
    VoxelState parent=voxel[stage];
    uint terminalMask=amrTerminalMask(parent);
    if(terminalMask==0u)return;
    uint base=partialNodeBase(stage),begin=partial[base],count=partial[base+1u];
    if(chunk>=count||(partial[partialChunkMaskBase()+partial[base+142u]+
        chunk/PARTIAL_WELD_CHUNK]&terminalMask)==0u)return;
    uint rank=partial[base+2u];float fraction=partialFloat(base+3u);
    vec3 anchor[8];for(uint a=0u;a<rank;++a){uint id=voxelParticle(parent,int(a));
        if(id>=uint(gpuControl.x))return;anchor[a]=particle[id].predicted_base_inv_mass.xyz;}
    for(uint n=chunk;n<min(chunk+PARTIAL_WELD_CHUNK,count);++n){
        uint rel=partialRelationBase(begin+n),id=partial[rel];
        if((partial[rel+3u]&terminalMask)==0u)continue;
        if(id>=uint(gpuControl.x))continue;float weight=particle[id].prev_inv_mass.w;
        if(weight<=0.0)continue;vec3 target=vec3(0.0);
        for(uint a=0u;a<rank;++a)target+=anchor[a]*partialFloat(rel+4u+a);
        accumulate(id,(target-particle[id].predicted_base_inv_mass.xyz)*fraction,weight);
    }
}

bool amrMeasure(uint stage,VoxelState v, out float values[6]) {
    if (v.pos_rest_edge.w <= 0.0) return false;
    vec3 p[8];
    for (int i = 0; i < 8; ++i) {
        uint id = voxelParticle(v, i);
        if (id >= uint(gpuControl.x)) return false;
    }
    amrLoadCorners(stage,v,false,p);
    vec3 axis[3];
    axis[0]=((p[1]-p[0])+(p[3]-p[2])+(p[5]-p[4])+(p[7]-p[6]))*0.25;
    axis[1]=((p[2]-p[0])+(p[3]-p[1])+(p[6]-p[4])+(p[7]-p[5]))*0.25;
    axis[2]=((p[4]-p[0])+(p[5]-p[1])+(p[6]-p[2])+(p[7]-p[3]))*0.25;
    vec3 lengths=vec3(length(axis[0]),length(axis[1]),length(axis[2]));
    values[0]=(lengths.x-v.pos_rest_edge.w)/v.pos_rest_edge.w;
    values[1]=(lengths.y-v.pos_rest_edge.w)/v.pos_rest_edge.w;
    values[2]=(lengths.z-v.pos_rest_edge.w)/v.pos_rest_edge.w;
    values[3]=lengths.x>1e-8&&lengths.y>1e-8?dot(axis[0],axis[1])/(lengths.x*lengths.y):0.0;
    values[4]=lengths.x>1e-8&&lengths.z>1e-8?dot(axis[0],axis[2])/(lengths.x*lengths.z):0.0;
    values[5]=lengths.y>1e-8&&lengths.z>1e-8?dot(axis[1],axis[2])/(lengths.y*lengths.z):0.0;
    return true;
}

bool amrDeformed(uint stage,VoxelState v, float rootEdge) {
    float values[6];
    if (!amrMeasure(stage,v, values)) return false;
    float level=log2(max(rootEdge/max(v.pos_rest_edge.w,uVgsEpsilon),1.0));
    float levelFraction=clamp(level/max(float(amrControl.levels),1.0),0.0,1.0);
    float fraction=mix(amrControl.deformation_coarse_fraction,
                       amrControl.deformation_fine_fraction,levelFraction);
    float maxStrain=max(max(abs(values[0]),abs(values[1])),abs(values[2]));
    float maxShear=max(max(abs(values[3]),abs(values[4])),abs(values[5]));
    return maxStrain>fraction*uStrainBreakThreshold ||
           maxShear>fraction*uShearBreakThreshold;
}

void amrClear(uint gid) {
    if (gid != 0u) return;
    amrControl.constraint_count=0u;
    amrControl.frame_refine_count=0u;
    amrControl.frame_coarsen_count=0u;
    amrControl.changed=0u;
    gpuControl.y=0;
    dispatchArgs[8]=0u;
}

void amrSample(uint gid) {
    if (gid >= amrControl.constraint_count) return;
    uint base=16u+gid*4u;
    if(dispatchArgs[base]!=0u)return;
    uint stage=dispatchArgs[base+1u];
    if(stage>=amrControl.total_stage_count)return;
    amrState[stage].previous[7]=uintBitsToFloat(0u);
    VoxelState v=voxel[stage];
    if (v.flags.w==0||!amrRepresented(v)) return;
    float values[6];
    if (!amrMeasure(stage,v,values)) return;
    float curvature=0.0;
    if (amrControl.sample_count>=2u && uDt>0.0) {
        float invDtSquared=1.0/(uDt*uDt);
        for(int i=0;i<6;++i)
            curvature=max(curvature,abs(values[i]-2.0*amrState[stage].latest[i]+
                                         amrState[stage].previous[i])*invDtSquared);
    }
    for(int i=0;i<6;++i){
        amrState[stage].previous[i]=amrState[stage].latest[i];
        amrState[stage].latest[i]=values[i];
    }
    amrState[stage].latest[6]=isnan(curvature)||isinf(curvature)?1000.0:curvature;
}

void amrSelect(uint gid) {
    uint activeBase=16u+4u*amrControl.constraint_capacity;
    if(gid>=dispatchArgs[activeBase])return;
    uint stage=dispatchArgs[activeBase+4u+gid];
    if(stage<uint(uVoxelCount))return;
    VoxelState node=voxel[stage];
    if(node.flags.w==0||!amrRepresented(node))return;
    bool hasChildren=amrHasActiveChildren(node);
    // A broken internal terminal must hand its mass to one child level.  It
    // remains disabled as a constraint and only acts as a topology ancestor.
    if(node.flags.x==0){
        if(!hasChildren){
            amrState[stage].previous[7]=uintBitsToFloat(AMR_DECISION_REFINE);
            atomicOr(amrControl.changed,1u);
        }
        return;
    }
    uint rootStage=floatBitsToUint(amrState[stage].previous[6]);
    if(rootStage>=amrControl.total_stage_count)return;
    float rootEdge=voxel[rootStage].pos_rest_edge.w;
    float level=log2(max(rootEdge/max(node.pos_rest_edge.w,uVgsEpsilon),1.0));
    float threshold=amrControl.curvature_threshold*pow(amrControl.threshold_factor,level);
    bool deformed=uVgsBegin!=0&&amrDeformed(stage,node,rootEdge);
    if(!hasChildren){
        bool forced=(node.lifecycle.w&AMR_FORCE_REFINED)!=0u;
        if(forced||amrState[stage].latest[6]>threshold||deformed){
            amrState[stage].previous[7]=uintBitsToFloat(AMR_DECISION_REFINE);
            atomicOr(amrControl.changed,1u);
        }
        return;
    }
    float childMean=0.0;uint childCount=0u;
    bool grandchildren=false,broken=false,childDeformed=false;
    for(int c=0;c<8;++c){
        uint child=amrChild(node,c);
        if(child>=amrControl.total_stage_count)continue;
        VoxelState cv=voxel[child];
        if(amrOccupancy(cv)==0u)continue;
        childCount++;
        broken=broken||cv.flags.x==0;
        childMean+=amrState[child].latest[6];
        if(uVgsBegin!=0)childDeformed=childDeformed||amrDeformed(child,cv,rootEdge);
        if(child>=uint(uVoxelCount))grandchildren=grandchildren||amrHasActiveChildren(cv);
    }
    if(childCount>0u)childMean/=float(childCount);
    bool forced=(node.lifecycle.w&AMR_FORCE_REFINED)!=0u;
    if(!forced&&!deformed&&!childDeformed&&amrState[stage].latest[6]<threshold&&
       childMean<amrControl.threshold_factor*threshold&&!grandchildren&&!broken){
        amrState[stage].previous[7]=uintBitsToFloat(AMR_DECISION_COARSEN);
        atomicOr(amrControl.changed,1u);
    }
}

void amrResolve(uint gid) {
    uint activeBase=16u+4u*amrControl.constraint_capacity;
    if(gid>=dispatchArgs[activeBase])return;
    uint stage=dispatchArgs[activeBase+4u+gid];
    if(stage<uint(uVoxelCount))return;
    uint parent=floatBitsToUint(amrState[stage].latest[7]);
    if(parent<amrControl.total_stage_count&&
       (floatBitsToUint(amrState[parent].previous[7])&AMR_DECISION_COARSEN)!=0u)
        amrState[stage].previous[7]=uintBitsToFloat(0u);
}

uint amrGridParticle(VoxelState parent,int r){
    int gx=r%3,gy=(r/3)%3,gz=r/9;
    int childCorner=(gx==2?1:0)|((gy==2?1:0)<<1)|((gz==2?1:0)<<2);
    int localCorner=(gx!=0?1:0)|((gy!=0?1:0)<<1)|((gz!=0?1:0)<<2);
    uint child=amrChild(parent,childCorner);
    return child<amrControl.total_stage_count?voxelParticle(voxel[child],localCorner):0xffffffffu;
}

void amrScratchClear(uint gid){
    if(gid>=amrControl.particle_capacity)return;
    amrScratch[gid].position_sum=uvec4(0u);
    amrScratch[gid].velocity_sum_mass=uvec4(0u);
}

void atomicAddAmrPosition(uint id,int component,float value){
    if(value==0.0)return;
    uint expected=amrScratch[id].position_sum[component];
    for(;;){uint desired=floatBitsToUint(uintBitsToFloat(expected)+value);
        uint observed=atomicCompSwap(amrScratch[id].position_sum[component],expected,desired);
        if(observed==expected)return;expected=observed;}
}

void atomicAddAmrVelocityMass(uint id,int component,float value){
    if(value==0.0)return;
    uint expected=amrScratch[id].velocity_sum_mass[component];
    for(;;){uint desired=floatBitsToUint(uintBitsToFloat(expected)+value);
        uint observed=atomicCompSwap(amrScratch[id].velocity_sum_mass[component],expected,desired);
        if(observed==expected)return;expected=observed;}
}

void amrAccumulateTarget(uint id,vec3 position,vec3 velocity,float weight){
    if(id>=amrControl.particle_capacity||weight<=0.0)return;
    atomicAddAmrPosition(id,0,position.x*weight);
    atomicAddAmrPosition(id,1,position.y*weight);
    atomicAddAmrPosition(id,2,position.z*weight);
    atomicAddAmrPosition(id,3,weight);
    atomicAddAmrVelocityMass(id,0,velocity.x*weight);
    atomicAddAmrVelocityMass(id,1,velocity.y*weight);
    atomicAddAmrVelocityMass(id,2,velocity.z*weight);
}

void amrFullTransitionScatter(uint gid){
    if(gid>=amrControl.hierarchy_count)return;
    uint stage=uint(uVoxelCount)+gid;
    uint decision=floatBitsToUint(amrState[stage].previous[7]);
    if(decision==0u)return;
    VoxelState parent=voxel[stage];
    if((decision&AMR_DECISION_REFINE)!=0u){
        vec3 coarsePos[8],coarseVel[8];
        for(int c=0;c<8;++c){uint id=voxelParticle(parent,c);if(id>=uint(gpuControl.x))return;
            coarsePos[c]=particle[id].pos_radius.xyz;coarseVel[c]=particle[id].velocity.xyz;}
        for(int r=0;r<27;++r){int gx=r%3,gy=(r/3)%3,gz=r/9;
            if(gx!=1&&gy!=1&&gz!=1)continue;uint id=amrGridParticle(parent,r);
            if(id>=uint(gpuControl.x)||particle[id].predicted_base_inv_mass.w>0.0)continue;
            vec3 p=vec3(0.0),v=vec3(0.0);for(int c=0;c<8;++c){
                float w=WELD_A[2*gx+(c&1)]*WELD_A[2*gy+((c>>1)&1)]*WELD_A[2*gz+((c>>2)&1)];
                p+=coarsePos[c]*w;v+=coarseVel[c]*w;}amrAccumulateTarget(id,p,v,1.0);}
    }else if((decision&AMR_DECISION_COARSEN)!=0u){
        vec3 finePos[27],fineVel[27];
        for(int r=0;r<27;++r){uint id=amrGridParticle(parent,r);if(id>=uint(gpuControl.x))return;
            finePos[r]=particle[id].pos_radius.xyz;fineVel[r]=particle[id].velocity.xyz;}
        for(int c=0;c<8;++c){vec3 p=vec3(0.0),v=vec3(0.0);for(int r=0;r<27;++r){
            int gx=r%3,gy=(r/3)%3,gz=r/9;float w=WELD_R[3*(c&1)+gx]*
            WELD_R[3*((c>>1)&1)+gy]*WELD_R[3*((c>>2)&1)+gz];p+=finePos[r]*w;v+=fineVel[r]*w;}
            amrAccumulateTarget(voxelParticle(parent,c),p,v,1.0);}
    }
}

void amrFullDormantScatter(uint gid){
    if(gid>=uint(uVgsCount))return;
    uint stage=uint(uVgsBegin)+gid;
    if(stage<uint(uVoxelCount)||stage>=amrControl.total_stage_count)return;
    VoxelState parent=voxel[stage];
    if(!amrRepresented(parent))return;
    if(parent.flags.w!=0&&amrHasActiveChildren(parent))return;
    vec3 coarsePos[8],coarseVel[8];
    for(int c=0;c<8;++c){uint id=voxelParticle(parent,c);if(id>=uint(gpuControl.x))return;
        coarsePos[c]=particle[id].pos_radius.xyz;coarseVel[c]=particle[id].velocity.xyz;}
    for(int r=0;r<27;++r){int gx=r%3,gy=(r/3)%3,gz=r/9;if(gx!=1&&gy!=1&&gz!=1)continue;
        uint id=amrGridParticle(parent,r);if(id>=uint(gpuControl.x))continue;
        vec3 p=vec3(0.0),v=vec3(0.0);for(int c=0;c<8;++c){float w=WELD_A[2*gx+(c&1)]*
        WELD_A[2*gy+((c>>1)&1)]*WELD_A[2*gz+((c>>2)&1)];p+=coarsePos[c]*w;v+=coarseVel[c]*w;}
        amrAccumulateTarget(id,p,v,1.0);}
}

void amrTransitionScatter(uint gid){
    if(amrControl.padding[0]==0u){
        uint activeBase=16u+4u*amrControl.constraint_capacity;
        if(gid>=dispatchArgs[activeBase])return;
        uint stage=dispatchArgs[activeBase+4u+gid];
        if(stage>=uint(uVoxelCount))amrFullTransitionScatter(stage-uint(uVoxelCount));
        return;
    }
    if(gid<amrControl.hierarchy_count){uint stage=uint(uVoxelCount)+gid;
        if(!amrPartial(voxel[stage]))amrFullTransitionScatter(gid);}
    if(gid<amrControl.padding[3]){
        uint offsets=amrControl.hierarchy_count*PARTIAL_NODE_WORDS+
                     amrControl.padding[0]*PARTIAL_REL_WORDS;
        uint incidences=offsets+amrControl.padding[1]+1u;
        uint jobs=incidences+amrControl.padding[0];
        uint id=partial[jobs+amrControl.padding[2]+gid];
        if(particle[id].predicted_base_inv_mass.w<=0.0){
        vec3 p=vec3(0.0),v=vec3(0.0);float count=0.0;
        for(uint i=partial[offsets+id];i<partial[offsets+id+1u];++i){
            uint rel=partialRelationBase(partial[incidences+i]);
            uint stage=uint(uVoxelCount)+partial[rel+1u];
            if(stage>=amrControl.total_stage_count||
               (floatBitsToUint(amrState[stage].previous[7])&AMR_DECISION_REFINE)==0u)continue;
            VoxelState parent=voxel[stage];uint base=partialNodeBase(stage);
            uint rank=partial[base+2u];
            for(uint a=0u;a<rank;++a){uint anchor=voxelParticle(parent,int(a));
                if(anchor>=uint(gpuControl.x))continue;float w=partialFloat(rel+4u+a);
                p+=particle[anchor].pos_radius.xyz*w;v+=particle[anchor].velocity.xyz*w;}
            count+=1.0;
        }
        if(count>0.0)amrAccumulateTarget(id,p/count,v/count,1.0);
        }
    }
    if(gid<amrControl.hierarchy_count*8u){
        uint node=gid/8u,a=gid%8u,stage=uint(uVoxelCount)+node;
        VoxelState parent=voxel[stage];
        if(!amrPartial(parent)||
           (floatBitsToUint(amrState[stage].previous[7])&AMR_DECISION_COARSEN)==0u)return;
        uint base=partialNodeBase(stage),rank=partial[base+2u];if(a>=rank)return;
        uint begin=partial[base],count=partial[base+1u];vec3 p=vec3(0.0),v=vec3(0.0);
        for(uint n=0u;n<count;++n){uint rel=partialRelationBase(begin+n),id=partial[rel];
            if(id>=uint(gpuControl.x))return;float w=partialFloat(rel+12u+a);
            p+=particle[id].pos_radius.xyz*w;v+=particle[id].velocity.xyz*w;}
        amrAccumulateTarget(voxelParticle(parent,int(a)),p,v,1.0);
    }
}

void amrDormantScatter(uint gid){
    // Full descendants are initialized by refinement. Embedded partial
    // terminals still need fine coordinates between transitions.
    if(uVgsCount<=0)return;
    uint firstNode=partialNodeBase(uint(uVgsBegin));
    if(gid>=partial[firstNode+141u])return;
    uint offsets=amrControl.hierarchy_count*PARTIAL_NODE_WORDS+
                 amrControl.padding[0]*PARTIAL_REL_WORDS;
    uint incidences=offsets+amrControl.padding[1]+1u;
    uint jobs=incidences+amrControl.padding[0];
    uint id=partial[jobs+partial[firstNode+140u]+gid];
    if(particle[id].prev_inv_mass.w>0.0)return;
    vec3 p=vec3(0.0),v=vec3(0.0);float count=0.0;
    for(uint i=partial[offsets+id];i<partial[offsets+id+1u];++i){
        uint rel=partialRelationBase(partial[incidences+i]);
        uint stage=uint(uVoxelCount)+partial[rel+1u];
        if(stage<uint(uVgsBegin)||stage>=uint(uVgsBegin+uVgsCount)||
           stage>=amrControl.total_stage_count)continue;
        VoxelState parent=voxel[stage];
        if(parent.flags.w!=0&&amrHasActiveChildren(parent))continue;
        uint base=partialNodeBase(stage),rank=partial[base+2u];
        for(uint a=0u;a<rank;++a){uint anchor=voxelParticle(parent,int(a));
            if(anchor>=uint(gpuControl.x))continue;float w=partialFloat(rel+4u+a);
            p+=particle[anchor].pos_radius.xyz*w;v+=particle[anchor].velocity.xyz*w;}
        count+=1.0;
    }
    if(count>0.0)amrAccumulateTarget(id,p/count,v/count,1.0);
}

void amrTransitionApply(uint gid){
    if(gid>=uint(gpuControl.x))return;
    float weight=uintBitsToFloat(amrScratch[gid].position_sum.w);if(weight<=0.0)return;
    vec3 p=vec3(uintBitsToFloat(amrScratch[gid].position_sum.x),
                uintBitsToFloat(amrScratch[gid].position_sum.y),
                uintBitsToFloat(amrScratch[gid].position_sum.z))/weight;
    vec3 v=vec3(uintBitsToFloat(amrScratch[gid].velocity_sum_mass.x),
                uintBitsToFloat(amrScratch[gid].velocity_sum_mass.y),
                uintBitsToFloat(amrScratch[gid].velocity_sum_mass.z))/weight;
    ParticleState s=particle[gid];s.pos_radius.xyz=p;s.prev_inv_mass.xyz=p;
    s.predicted_base_inv_mass.xyz=p;s.velocity.xyz=v;particle[gid]=s;
}

void amrTopologyApply(uint gid){
    uint activeBase=16u+4u*amrControl.constraint_capacity;
    if(gid>=dispatchArgs[activeBase])return;
    uint stage=dispatchArgs[activeBase+4u+gid];
    if(stage<uint(uVoxelCount))return;
    uint decision=floatBitsToUint(amrState[stage].previous[7]);if(decision==0u)return;
    bool refine=(decision&AMR_DECISION_REFINE)!=0u;VoxelState parent=voxel[stage];
    for(int c=0;c<8;++c){uint child=amrChild(parent,c);if(child>=amrControl.total_stage_count)continue;
        VoxelState cv=voxel[child];if(amrOccupancy(cv)==0u)continue;
        cv.flags.w=refine?1:0;voxel[child]=cv;if(refine){
        float parentId=amrState[child].latest[7];amrState[child]=amrState[stage];
        amrState[child].latest[7]=parentId;amrState[child].previous[7]=uintBitsToFloat(0u);}}
    amrState[stage].previous[7]=uintBitsToFloat(0u);
    if(refine){atomicAdd(amrControl.frame_refine_count,1u);atomicAdd(amrControl.total_refine_count,1u);}
    else{float values[6];if(amrMeasure(stage,parent,values)){for(int i=0;i<6;++i){
        amrState[stage].latest[i]=values[i];amrState[stage].previous[i]=values[i];}
        amrState[stage].latest[6]=0.0;}atomicAdd(amrControl.frame_coarsen_count,1u);
        atomicAdd(amrControl.total_coarsen_count,1u);}
    atomicExchange(amrControl.changed,1u);atomicAdd(amrControl.topology_generation,1u);
}

void amrMassScatter(uint gid){
    uint activeBase=16u+4u*amrControl.constraint_capacity;
    if(gid>=dispatchArgs[activeBase])return;
    gid=dispatchArgs[activeBase+4u+gid];VoxelState v=voxel[gid];
    if(v.flags.w==0||!amrRepresented(v))return;
    if(gid>=uint(uVoxelCount)&&amrHasActiveChildren(v))return;
    if(amrPartial(v)){
        uint base=partialNodeBase(gid),rank=partial[base+2u];
        float total=amrControl.mass_density*v.velocity_rest_volume.w*partialFloat(base+3u);
        for(uint a=0u;a<rank;++a){uint id=voxelParticle(v,int(a));
            if(id<amrControl.particle_capacity)
                atomicAddAmrVelocityMass(id,3,total*partialFloat(base+4u+a));}
        return;
    }
    float contribution=amrControl.mass_density*v.velocity_rest_volume.w*0.125;
    for(int c=0;c<8;++c){uint id=voxelParticle(v,c);if(id<amrControl.particle_capacity)
        atomicAddAmrVelocityMass(id,3,contribution);}
}

void amrCompact(uint gid){
    if(gid>=uint(gpuControl.x))return;float mass=uintBitsToFloat(amrScratch[gid].velocity_sum_mass.w);
    ParticleState p=particle[gid];p.prev_inv_mass.w=mass>0.0?1.0/mass:0.0;
    p.predicted_base_inv_mass.w=p.prev_inv_mass.w;particle[gid]=p;if(mass<=0.0)return;
    uint slot=atomicAdd(gpuControl.y,1);if(slot<amrControl.particle_capacity)simId[slot]=gid;
    else atomicOr(amrControl.overflow,AMR_OVERFLOW_PARTICLE);
    if(cloneParent[gid]<0){uint collision=atomicAdd(dispatchArgs[8],1u);
        if(collision<amrControl.particle_capacity)simId[amrControl.particle_capacity+collision]=gid;
        else atomicOr(amrControl.overflow,AMR_OVERFLOW_PARTICLE);}
}

uint amrTerminalMask(VoxelState parent){
    if(parent.flags.x==0||parent.flags.w==0)return 0u;uint mask=0u;
    for(int c=0;c<8;++c){uint child=amrChild(parent,c);if(child>=amrControl.total_stage_count)continue;
        VoxelState cv=voxel[child];if(cv.flags.x==0||cv.flags.w==0)continue;
        if(child>=amrControl.total_stage_count-amrControl.hierarchy_count&&amrHasActiveChildren(cv))continue;
        mask|=1u<<c;}return mask;
}

uint amrEmbeddedRelation(uint id);

void amrCompile(uint gid){
    if(gid>=amrControl.total_stage_count)return;VoxelState v=voxel[gid];
    bool embeddedTerminal=gid<uint(uVoxelCount)&&v.flags.w==0&&
        amrControl.padding[0]!=0u&&
        amrEmbeddedRelation(voxelParticle(v,0))!=0xffffffffu;
    if((v.flags.w==0&&!embeddedTerminal)||!amrRepresented(v)||
       v.flags.y!=0||v.flags.z!=0)return;
    uint activeBase=16u+4u*amrControl.constraint_capacity;
    uint activeSlot=atomicAdd(dispatchArgs[activeBase],1u);
    if(activeSlot<amrControl.total_stage_count)dispatchArgs[activeBase+4u+activeSlot]=gid;
    else atomicOr(amrControl.overflow,AMR_OVERFLOW_CONSTRAINT);
    if(v.flags.x==0||v.flags.w==0)return;
    bool embedded=amrPartial(v);
    uint mask=gid>=uint(uVoxelCount)?amrTerminalMask(v):0u;
    uint chunks=0u,chunkBegin=0u,chunkCount=0u;if(embedded&&mask!=0u){
        uint base=partialNodeBase(gid);
        chunkBegin=partial[base+142u];chunkCount=partial[base+143u];
        uint maskBase=partialChunkMaskBase();
        for(uint c=0u;c<chunkCount;++c)chunks+=uint((partial[maskBase+chunkBegin+c]&mask)!=0u);}
    uint emit=1u+(!embedded&&mask!=0u?1u:0u)+chunks;
    uint slot=atomicAdd(amrControl.constraint_count,emit);
    if(slot+emit>amrControl.constraint_capacity){atomicOr(amrControl.overflow,AMR_OVERFLOW_CONSTRAINT);return;}
    uint base=16u+slot*4u;dispatchArgs[base]=0u;dispatchArgs[base+1u]=gid;
    dispatchArgs[base+2u]=0u;dispatchArgs[base+3u]=0u;if(!embedded&&mask!=0u){base+=4u;
    dispatchArgs[base]=1u;dispatchArgs[base+1u]=gid;dispatchArgs[base+2u]=mask;dispatchArgs[base+3u]=0u;}
    if(chunks!=0u){uint maskBase=partialChunkMaskBase();
        for(uint c=0u;c<chunkCount;++c){if((partial[maskBase+chunkBegin+c]&mask)==0u)continue;
            base+=4u;dispatchArgs[base]=3u;dispatchArgs[base+1u]=gid;
            dispatchArgs[base+2u]=c*PARTIAL_WELD_CHUNK;dispatchArgs[base+3u]=0u;}}
}

void amrPrepareIndirect(uint gid){
    if(gid!=0u)return;dispatchArgs[0]=(uint(max(gpuControl.y,0))+127u)/128u;
    dispatchArgs[1]=1u;dispatchArgs[2]=1u;dispatchArgs[4]=(dispatchArgs[8]+127u)/128u;
    dispatchArgs[5]=1u;dispatchArgs[6]=1u;dispatchArgs[13]=(amrControl.constraint_count+127u)/128u;
    dispatchArgs[14]=1u;dispatchArgs[15]=1u;
    uint activeBase=16u+4u*amrControl.constraint_capacity;
    dispatchArgs[activeBase+1u]=(dispatchArgs[activeBase]+127u)/128u;
    dispatchArgs[activeBase+2u]=1u;dispatchArgs[activeBase+3u]=1u;
}

const int AMR_HEX_FACE_CORNERS[24]=int[24](
    0,4,6,2, 1,3,7,5, 0,1,5,4,
    2,6,7,3, 0,2,3,1, 4,5,7,6);

struct SphereContact { uint aProxy; uint bProxy; float depth; vec3 normal; };

bool loadSphereShape(uint voxelId,out vec3 position[9],out uint particleId[8]){
    VoxelState v=voxel[voxelId];vec3 center=vec3(0.0);
    for(int c=0;c<8;++c){uint id=voxelParticle(v,c);if(id>=uint(gpuControl.x))return false;
        particleId[c]=id;position[c]=particle[id].predicted_base_inv_mass.xyz;center+=position[c]*0.125;}
    position[8]=center;return true;
}

void loadSphereRadii(float edge,uint particleId[8],out float radius[9]){
    for(int c=0;c<8;++c)radius[c]=particle[particleId[c]].pos_radius.w;
