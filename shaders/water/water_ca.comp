#version 430
layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer MassBuffer { uint mass[]; };
layout(std430, binding = 1) buffer ScratchBuffer { uint scratch[]; };
layout(std430, binding = 2) readonly buffer StaticMaskBuffer { uint staticMask[]; };
layout(std430, binding = 3) readonly buffer DynamicMaskBuffer { uint dynamicMask[]; };
layout(std430, binding = 4) readonly buffer ActiveTileBuffer { uint activeTiles[]; };
layout(std430, binding = 5) readonly buffer ActiveTileIdBuffer { uint activeTileIds[]; };
uniform int uMode;
uniform int uCellCount;
const uint WATER_MAX = 65535u;
const uint LATERAL_SUPPORT_MASS = 60000u;
const int SIZE_X = 80, SIZE_Y = 80, SIZE_Z = 80;
const int LAYER = SIZE_X * SIZE_Z, TILE_PAIRS = 256;
uint loadMass(int i) { return (mass[i >> 1] >> ((i & 1) * 16)) & WATER_MAX; }
uint loadScratch(int i) { return (scratch[i >> 1] >> ((i & 1) * 16)) & WATER_MAX; }
bool staticBit(int i) { return ((staticMask[i >> 5] >> (i & 31)) & 1u) != 0u; }
bool dynamicBit(int i) { return ((dynamicMask[i >> 5] >> (i & 31)) & 1u) != 0u; }
bool blocked(int i) { return staticBit(i) || dynamicBit(i); }
int tileForIndex(int i) { int y=i/LAYER, r=i-y*LAYER, z=r/SIZE_X, x=r-z*SIZE_X;
    return (x/8)+10*((z/8)+10*(y/8)); }
bool tileActive(int t) { return ((activeTiles[t >> 5] >> (t & 31)) & 1u) != 0u; }
uint downFlow(int i, int y) { if (blocked(i)||y==0) return 0u; int b=i-LAYER;
    if (blocked(b)||!tileActive(tileForIndex(i))||!tileActive(tileForIndex(b))) return 0u;
    return min(loadMass(i), WATER_MAX-loadMass(b)); }
uint horizontalFlow(int f, int t) { if (t<0||t>=SIZE_X*SIZE_Y*SIZE_Z||blocked(f)||blocked(t)||
    !tileActive(tileForIndex(f))||!tileActive(tileForIndex(t))) return 0u;
    int fy=f/LAYER; if(fy>0){int below=f-LAYER;
    if(!blocked(below)&&loadScratch(below)<LATERAL_SUPPORT_MASS)return 0u;}
    uint a=loadScratch(f), b=loadScratch(t); return a>b ? (a-b)>>3 : 0u; }
uint gravityValue(int i,int y) { if(blocked(i)) return loadMass(i); uint o=downFlow(i,y);
    uint n=y+1<SIZE_Y?downFlow(i+LAYER,y+1):0u; return loadMass(i)-o+n; }
uint horizontalValue(int i,int x,int z) { uint v=loadScratch(i); if(blocked(i)) return v;
    int ns[4]=int[4](x+1<SIZE_X?i+1:-1,x>0?i-1:-1,z+1<SIZE_Z?i+SIZE_X:-1,z>0?i-SIZE_X:-1);
    uint o=0u,n=0u; for(int k=0;k<4;++k){if(ns[k]<0)continue;o+=horizontalFlow(i,ns[k]);n+=horizontalFlow(ns[k],i);} return v-o+n; }
void main() { int inv=int(gl_GlobalInvocationID.x); if(inv>=uCellCount)return;
    int job=inv/TILE_PAIRS,pair=inv-job*TILE_PAIRS,tile=int(activeTileIds[job]);
    int ty=tile/100,r=tile-ty*100,tz=r/10,tx=r-tz*10;
    int x=tx*8+((pair&3)<<1),z=tz*8+((pair>>2)&7),y=ty*8+(pair>>5);
    int i0=x+SIZE_X*(z+SIZE_Z*y),i1=i0+1; uint lo,hi;
    if(uMode==0){lo=gravityValue(i0,y);hi=gravityValue(i1,y);scratch[i0>>1]=lo|(hi<<16);}
    else{lo=horizontalValue(i0,x,z);hi=horizontalValue(i1,x+1,z);mass[i0>>1]=lo|(hi<<16);} }
