#version 460
#extension GL_EXT_shader_atomic_float : require

#ifndef LOCAL_SIZE
#define LOCAL_SIZE 256
#endif
layout(local_size_x = LOCAL_SIZE) in;

const int kParticlesBinding = 2;
const int kGlueBinding = 9;
const int kVoxelStride = 8;
const float kEps = 1e-6;

struct XpbdParticle
{
   vec4 xpos;   // xpos.w == radius
   vec4 xprev;  // xprev.w == w (1.0/mass)
   vec4 vel;    // vel.w = mu (coefficient of friction)
   uvec4 flags;
};

struct GlueConstraint
{
    ivec4 coarseCorner; // 4 corners on coarse voxel
    vec4 weights;       // barycentric weights for coarse corners
    ivec4 indices;      // x = coarseVoxel, y = fineVoxel, z = fineCorner
    vec4 restLocal;     // x=u, y=v, z=n, w=strength
};

layout (std430, binding = kParticlesBinding) coherent buffer PARTICLES
{
    XpbdParticle particles[];
};

layout (std430, binding = kGlueBinding) readonly buffer GLUE
{
    GlueConstraint glueConstraints[];
};

float GetW(XpbdParticle p) { return p.xprev.w; }

vec3 safe_norm(vec3 v)
{
    float len = length(v);
    if (len < kEps) {
        return vec3(0.0);
    }
    return v / len;
}

void main()
{
    int gid = int(gl_GlobalInvocationID.x);
    if (gid >= glueConstraints.length()) {
        return;
    }

    GlueConstraint gc = glueConstraints[gid];
    int coarseVoxel = gc.indices.x;
    int fineVoxel = gc.indices.y;
    int fineCorner = gc.indices.z;
    if (coarseVoxel < 0 || fineVoxel < 0 || fineCorner < 0) {
        return;
    }

    int coarseBase = coarseVoxel * kVoxelStride;
    int fineIndex = fineVoxel * kVoxelStride + fineCorner;
    if (fineIndex < 0 || fineIndex >= particles.length()) {
        return;
    }

    vec3 coarsePos[4];
    float coarseInv[4];
    for (int k = 0; k < 4; ++k) {
        int idx = coarseBase + gc.coarseCorner[k];
        if (idx < 0 || idx >= particles.length()) {
            return;
        }
        XpbdParticle pk = particles[idx];
        coarsePos[k] = pk.xpos.xyz;
        coarseInv[k] = GetW(pk);
    }

    XpbdParticle fineParticle = particles[fineIndex];
    vec3 finePos = fineParticle.xpos.xyz;
    float fineInv = GetW(fineParticle);

    vec3 coarseU = coarsePos[1] - coarsePos[0];
    vec3 coarseV = coarsePos[2] - coarsePos[0];
    vec3 basisU = safe_norm(coarseU);
    vec3 basisV = coarseV - basisU * dot(coarseV, basisU);
    float basisVLen = length(basisV);
    if (basisVLen < kEps) {
        return;
    }
    basisV = basisV / basisVLen;
    vec3 basisN = safe_norm(cross(basisU, basisV));

    vec3 anchor = vec3(0.0);
    anchor += coarsePos[0] * gc.weights.x;
    anchor += coarsePos[1] * gc.weights.y;
    anchor += coarsePos[2] * gc.weights.z;
    anchor += coarsePos[3] * gc.weights.w;

    vec3 target = anchor + basisU * gc.restLocal.x + basisV * gc.restLocal.y + basisN * gc.restLocal.z;
    vec3 C = target - finePos;

    float invMassSum = fineInv;
    float w0 = gc.weights.x;
    float w1 = gc.weights.y;
    float w2 = gc.weights.z;
    float w3 = gc.weights.w;
    invMassSum += w0 * w0 * coarseInv[0];
    invMassSum += w1 * w1 * coarseInv[1];
    invMassSum += w2 * w2 * coarseInv[2];
    invMassSum += w3 * w3 * coarseInv[3];
    if (invMassSum <= 0.0) {
        return;
    }

    vec3 lambda = -gc.restLocal.w * C / invMassSum;

    for (int k = 0; k < 4; ++k) {
        float inv_m = coarseInv[k];
        if (inv_m <= 0.0) {
            continue;
        }
        float weight = gc.weights[k];
        vec3 delta = lambda * weight * inv_m;
        int idx = coarseBase + gc.coarseCorner[k];
        atomicAdd(particles[idx].xpos.x, delta.x);
        atomicAdd(particles[idx].xpos.y, delta.y);
        atomicAdd(particles[idx].xpos.z, delta.z);
    }

    if (fineInv > 0.0) {
        vec3 fineDelta = -lambda * fineInv;
        atomicAdd(particles[fineIndex].xpos.x, fineDelta.x);
        atomicAdd(particles[fineIndex].xpos.y, fineDelta.y);
        atomicAdd(particles[fineIndex].xpos.z, fineDelta.z);
    }
}
